    vec3(512.0,-512.0,0.0),
    vec3(576.0,512.0,512.0),
    vec3(-576.0,512.0,-64.0),
    vec3(576.0,1600.0,0.0),
    vec3(-576.0,512.0,512.0),
    vec3(576.0,1600.0,576.0),
