bool nltSlab(vec3 ro,vec3 rd,vec3 mn,vec3 mx,out float tn,out float tf,out vec3 normal) {
    tn=-1e30;tf=1e30;normal=vec3(0.0);bool valid=true;
    for(int axis=0;axis<3;axis++) {
        if(abs(rd[axis])<1e-7) {
            if(ro[axis]<mn[axis] || ro[axis]>mx[axis]) valid=false;
        } else {
            float inv=1.0/rd[axis];
            float a=(mn[axis]-ro[axis])*inv,b=(mx[axis]-ro[axis])*inv;
            float lo=min(a,b),hi=max(a,b);
            if(lo>tn) { normal=vec3(0.0);normal[axis]=a>b ? 1.0 : -1.0; }
            tn=max(tn,lo);tf=min(tf,hi);
        }
        if(tn>tf) valid=false;
    }
    return valid && tf>1e-4;
}
bool nltIncidentSupported(vec3 ro,vec3 rd) {
    if(abs(rd.x)<1e-6) return false;
    float tm=(494.0-ro.x)/rd.x;
    vec3 p=ro+tm*rd;
    if(tm<=1e-4 || abs(p.y)>384.0 || p.z<0.0 || p.z>432.0) return false;
    float wall=100000.0;
    for(int i=0;i<20;i++) {
        float tn,tf;vec3 n;
        if(nltSlab(ro,rd,nltRoomBoxes[i*2],nltRoomBoxes[i*2+1],tn,tf,n)) {
            float t=tn<=1e-4 ? tf : tn;
            if(t>1.0) wall=min(wall,t);
        }
    }
    return tm<wall-0.5;
}
bool transportFeatures(vec3 ro,vec3 rd,out float x[28]) {
    for(int i=0;i<28;i++) x[i]=0.0;
    vec3 o=(ro-NLT_CENTER)/NLT_SCALE;
    for(int i=0;i<3;i++) { x[i]=o[i];x[i+3]=rd[i]; }
    float dx=abs(rd.x)>=1e-4 ? rd.x : (rd.x<0.0 ? -1e-4 : 1e-4);
    float t=clamp((988.0-ro.x)/dx,0.0,4096.0);
    vec2 p=clamp((ro.yz+t*rd.yz-vec2(0.0,175.0))/128.0,vec2(-8.0),vec2(8.0));
    x[6]=p.x;x[7]=p.y;
    for(int k=0;k<3;k++) {
        float f=3.14159265358979323846*float(1<<k);
        vec2 s=sin(f*p),c=cos(f*p);
        x[8+k*4]=s.x;x[9+k*4]=s.y;x[10+k*4]=c.x;x[11+k*4]=c.y;
    }
    vec3 vro=vec3(988.0-ro.x,ro.yz),vrd=vec3(-rd.x,rd.yz);
    float tn,tf;vec3 n;
    bool hit=nltSlab(vro,vrd,NLT_BBOX_MIN,NLT_BBOX_MAX,tn,tf,n);
    if(!hit) return false;
    float entry=max(tn,0.0);
    vec3 q=clamp(2.0*(vro+entry*vrd-NLT_BBOX_MIN)/(NLT_BBOX_MAX-NLT_BBOX_MIN)-1.0,vec3(-1.0),vec3(1.0));
    if(all(greaterThanEqual(vro,NLT_BBOX_MIN)) && all(lessThanEqual(vro,NLT_BBOX_MAX))) n=vec3(0.0);
    for(int i=0;i<3;i++) { x[20+i]=q[i];x[24+i]=n[i]; }
    x[23]=(tf-entry)/length(NLT_BBOX_MAX-NLT_BBOX_MIN);x[27]=1.0;
    return true;
}
vec4 evalTransport(vec3 ro,vec3 rd,bool incidentSupported) {
    if(!incidentSupported) return vec4(0.0);
    float x[28];if(!transportFeatures(ro,rd,x)) return vec4(0.0);
    float a[96],b[96];
    int b1=28*NLT_HIDDEN;
    int w2=b1+NLT_HIDDEN;
    int b2=w2+NLT_HIDDEN*NLT_HIDDEN;
    int w3=b2+NLT_HIDDEN;
    int b3=w3+4*NLT_HIDDEN;
    for(int i=0;i<NLT_HIDDEN;i++) {
        float v=NLT_WEIGHT(b1+i);
        for(int j=0;j<28;j++) v+=NLT_WEIGHT(i*28+j)*x[j];
        a[i]=max(v,0.0);
    }
    for(int i=0;i<NLT_HIDDEN;i++) {
        float v=NLT_WEIGHT(b2+i);
        for(int j=0;j<NLT_HIDDEN;j++) v+=NLT_WEIGHT(w2+i*NLT_HIDDEN+j)*a[j];
        b[i]=max(v,0.0);
    }
    vec4 result;
    for(int i=0;i<4;i++) {
        float v=NLT_WEIGHT(b3+i);
        for(int j=0;j<NLT_HIDDEN;j++) v+=NLT_WEIGHT(w3+i*NLT_HIDDEN+j)*b[j];
        result[i]=1.0/(1.0+exp(-clamp(v,-50.0,50.0)));
    }
    result.rgb*=result.a;
    return result;
}


vec4 transportDiagnostic(ivec2 p) {
    float stripe = float(((p.x / 8) + (p.y / 8)) % 2);
    return vec4(mix(vec3(0.04,0.0,0.04),vec3(0.9,0.0,0.65),stripe),1.0);
}
bool transportPlateCameraMatches(ivec2 size) {
    return neural.reflectionParams.z > 0.5 && neural.reflectionParams.y > 0.5 &&
        all(equal(textureSize(detailTexture,0),size)) &&
        length(neural.cameraOrigin.xyz-vec3(155.937546,-67.101807,171.0)) < 0.0002 &&
        length(neural.cameraForward.xyz-vec3(.99675071,.08035012,-.00565652)) < 0.000002 &&
        length(normalize(neural.cameraRight.xyz)-vec3(.08035140,-.99676663,0.0)) < 0.000002 &&
        length(normalize(neural.cameraUp.xyz)-vec3(.00563823,.00045451,.99998403)) < 0.000002 &&
        abs(neural.cameraRight.w-35.0) < 0.00001 &&
        abs(neural.cameraUp.w-20.114296) < 0.00001;
}
void mainTransport() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(outHDR);
    if (any(greaterThanEqual(p,size))) return;
    vec2 uv=(vec2(p)+vec2(.5))/vec2(size);
    vec3 ro=neural.cameraOrigin.xyz;
    vec3 rd=rayDirectionFromUv(uv);
    vec3 scene=texture(sceneColor,uv).rgb;
    bool incident=nltIncidentSupported(ro,rd);
    bool plateValid=transportPlateCameraMatches(size);
    bool modelValid=neural.reflectionMeta.x!=0 && (neural.activeObjectMeta.w & 255)!=0;
    int mode=neural.viewMode;
    vec4 signal=vec4(0.0),outColor;
    if (mode==3) {
        // This texture is an OFFLINE Cycles plate, not ray tracing at runtime.
        // Exact camera and native resolution are mandatory. No free-view reuse.
        if (!plateValid) outColor=transportDiagnostic(p);
        else {
            signal=incident ? texelFetch(detailTexture,p,0) : vec4(0.0);
            outColor=vec4(signal.rgb,1.0);
        }
    } else if (!modelValid) {
        outColor=transportDiagnostic(p); // never claim the old object is this scene
    } else {
        signal=evalTransport(ro,rd,incident);
        if (mode==6) outColor=vec4(signal.rgb,1.0);
        else if (mode==8) {
            if (!plateValid) outColor=transportDiagnostic(p);
            else {
                vec4 reference=incident ? texelFetch(detailTexture,p,0) : vec4(0.0);
                outColor=vec4(clamp(abs(signal.rgb-reference.rgb)*3.0,0.0,1.0),1.0);
            }
        } else outColor=vec4(signal.rgb,1.0);
    }
    if ((mode==7 && modelValid) || (mode==3 && plateValid && !neuralMirrorOnly())) {
        vec3 mirrorPoint,mirrorNormal;
        float mirrorT;
        if (incident && hitNeuralMirror(ro,rd,mirrorT,mirrorPoint,mirrorNormal)) {
            vec3 background=mirrorReceiverComposite(scene,mirrorPoint,rd,mirrorNormal);
            outColor=vec4(background*(1.0-.84*signal.a)+.84*signal.rgb,1.0);
        } else outColor=vec4(scene,1.0);
    }
    imageStore(outHDR,p,outColor);
    imageStore(outRoomId,p,vec4(2.0/255.0,0.0,0.0,1.0));
}

void mainSurface() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy), size=imageSize(outHDR);
    if(any(greaterThanEqual(p,size)))return;
    vec2 uv=(vec2(p)+.5)/vec2(size);
    vec3 ro=neural.cameraOrigin.xyz,rd=rayDirectionFromUv(uv);
    vec3 scene=texture(sceneColor,uv).rgb;
    bool incident=nltIncidentSupported(ro,rd);
    bool plateValid=transportPlateCameraMatches(size);
    // Native surface pixels must match the presentation target. Never silently
    // resize an FHD reconstruction or issue an out-of-range image load.
    bool valid=neural.reflectionMeta.x!=0 && all(equal(imageSize(surfaceSignal),size));
    int mode=neural.viewMode;
    vec4 signal=vec4(0), outColor;
    if(mode==3) {
        // Offline, pinned Cycles plate: live first-hit never samples this texture.
        if(!plateValid)outColor=transportDiagnostic(p);
        else {signal=incident?texelFetch(detailTexture,p,0):vec4(0);outColor=vec4(signal.rgb,1);}
    } else if(!valid)outColor=transportDiagnostic(p);
    else {
        signal=imageLoad(surfaceSignal,p); // already display-referred and premultiplied
        if(mode==8) {
            if(!plateValid)outColor=transportDiagnostic(p);
            else outColor=vec4(clamp(abs(signal.rgb-(incident?texelFetch(detailTexture,p,0).rgb:vec3(0.)))*3.,0.,1.),1.);
        } else if(mode==9)outColor=vec4(signal.a>0. && signal.a<1. ? vec3(1.,.25,0.) : vec3(signal.a),1.);
        else outColor=vec4(signal.rgb,1.);
    }
    if((mode==7 && valid) || (mode==3 && plateValid && !neuralMirrorOnly())) {
        vec3 point,normal; float t;
        if(incident && hitNeuralMirror(ro,rd,t,point,normal)) {
            vec3 background=mirrorReceiverComposite(scene,point,rd,normal);
            outColor=vec4(background*(1.-.84*signal.a)+.84*signal.rgb,1.);
        } else outColor=vec4(scene,1.);
    }
    imageStore(outHDR,p,outColor);imageStore(outRoomId,p,vec4(2./255.,0,0,1));
}
void main() {
    if (neural.reflectionMeta.z == 32032) mainSurface();
    else if (neural.reflectionMeta.z == 20002) mainTransport();
    else if (neural.reflectionMeta.z == 6276) mainRayPlane();
    else mainLegacy();
}
