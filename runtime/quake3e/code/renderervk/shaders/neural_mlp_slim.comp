#define MAX_NEURAL_ROOMS 32
#define MAX_NEURAL_OBJECTS 8
#define NEURAL_MLP_WEIGHT_COUNT 27
#define NEURAL_REFLECTION_INPUTS 130
#define NEURAL_REFLECTION_HIDDEN 256
#define NEURAL_REFLECTION_OUTPUTS 4
#define NEURAL_REFLECTION_POSE_CODE 64
#define NEURAL_REFLECTION_WEIGHT_COUNT 100356

#define NEURAL_REFLECTION_DECAL_TAG 4096
#define NEURAL_REFLECTION_DECAL_GEOM_INPUTS 19
#define NEURAL_REFLECTION_DECAL_ATLAS_WIDTH 32
#define NEURAL_REFLECTION_DECAL_ATLAS_HEIGHT 32
#define NEURAL_REFLECTION_DECAL_ALPHA_HIDDEN 12
#define NEURAL_REFLECTION_DECAL_COLOR_HIDDEN1 24
#define NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2 16
#define NEURAL_REFLECTION_DECAL_ATLAS_OFFSET 0
#define NEURAL_REFLECTION_DECAL_ALPHA_W1_OFFSET (NEURAL_REFLECTION_DECAL_ATLAS_OFFSET + NEURAL_REFLECTION_DECAL_ATLAS_WIDTH * NEURAL_REFLECTION_DECAL_ATLAS_HEIGHT * 4)
#define NEURAL_REFLECTION_DECAL_ALPHA_B1_OFFSET (NEURAL_REFLECTION_DECAL_ALPHA_W1_OFFSET + 20 * NEURAL_REFLECTION_DECAL_ALPHA_HIDDEN)
#define NEURAL_REFLECTION_DECAL_ALPHA_W2_OFFSET (NEURAL_REFLECTION_DECAL_ALPHA_B1_OFFSET + NEURAL_REFLECTION_DECAL_ALPHA_HIDDEN)
#define NEURAL_REFLECTION_DECAL_ALPHA_B2_OFFSET (NEURAL_REFLECTION_DECAL_ALPHA_W2_OFFSET + NEURAL_REFLECTION_DECAL_ALPHA_HIDDEN)
#define NEURAL_REFLECTION_DECAL_COLOR_W1_OFFSET (NEURAL_REFLECTION_DECAL_ALPHA_B2_OFFSET + 1)
#define NEURAL_REFLECTION_DECAL_COLOR_B1_OFFSET (NEURAL_REFLECTION_DECAL_COLOR_W1_OFFSET + 28 * NEURAL_REFLECTION_DECAL_COLOR_HIDDEN1)
#define NEURAL_REFLECTION_DECAL_COLOR_W2_OFFSET (NEURAL_REFLECTION_DECAL_COLOR_B1_OFFSET + NEURAL_REFLECTION_DECAL_COLOR_HIDDEN1)
#define NEURAL_REFLECTION_DECAL_COLOR_B2_OFFSET (NEURAL_REFLECTION_DECAL_COLOR_W2_OFFSET + NEURAL_REFLECTION_DECAL_COLOR_HIDDEN1 * NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2)
#define NEURAL_REFLECTION_DECAL_COLOR_W3_OFFSET (NEURAL_REFLECTION_DECAL_COLOR_B2_OFFSET + NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2)
#define NEURAL_REFLECTION_DECAL_COLOR_B3_OFFSET (NEURAL_REFLECTION_DECAL_COLOR_W3_OFFSET + NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2 * 4)

#define NEURAL_MIRROR_X 494.0
#define NEURAL_MIRROR_HALF_Y 384.0
#define NEURAL_MIRROR_MIN_Z 0.0
#define NEURAL_MIRROR_MAX_Z 432.0

layout(std430, binding = 2) readonly buffer NeuralRooms {
	int roomCount;
	int weightCount;
	int viewMode;
	int activeRoom;
	ivec4 activeObjectMeta;
	ivec4 activeObjectIds0;
	ivec4 activeObjectIds1;
	vec4 viewSeed;
	vec4 cameraOrigin;
	vec4 cameraForward;
	vec4 cameraRight;
	vec4 cameraUp;
	int roomId[MAX_NEURAL_ROOMS];
	int hasWeights[MAX_NEURAL_ROOMS];
	vec4 roomColor[MAX_NEURAL_ROOMS];
	float weights[MAX_NEURAL_ROOMS * NEURAL_MLP_WEIGHT_COUNT];
	int objectCount;
	int objectId[MAX_NEURAL_OBJECTS];
	int objectRoomId[MAX_NEURAL_OBJECTS];
