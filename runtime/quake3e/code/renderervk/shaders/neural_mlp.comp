bool intersectBox(vec3 ro, vec3 rd, vec3 mn, vec3 mx, out float tHit, out vec3 nHit) {
	float tNear = -100000.0;
	float tFar = 100000.0;
	vec3 nearNormal = vec3(0.0);

	for (int a = 0; a < 3; a++) {
		if (abs(rd[a]) < 0.0000001) {
			if (ro[a] < mn[a] || ro[a] > mx[a]) {
				return false;
			}
		} else {
			float t1 = (mn[a] - ro[a]) / rd[a];
			float t2 = (mx[a] - ro[a]) / rd[a];
			vec3 n1 = vec3(0.0);
			vec3 n2 = vec3(0.0);
			n1[a] = -1.0;
			n2[a] = 1.0;
			if (t1 > t2) {
				float tv = t1; t1 = t2; t2 = tv;
				vec3 nv = n1; n1 = n2; n2 = nv;
			}
			if (t1 > tNear) {
				tNear = t1;
				nearNormal = n1;
			}
			tFar = min(tFar, t2);
			if (tNear > tFar) {
				return false;
			}
		}
	}

	if (tFar <= 0.0001) {
		return false;
	}
	if (tNear <= 0.0001) {
		tHit = tFar;
		nHit = -nearNormal;
	} else {
		tHit = tNear;
		nHit = nearNormal;
	}
	return true;
}

vec2 surfaceUv(vec3 p, vec3 n) {
	vec3 an = abs(n);
	if (an.z > 0.5) {
		return p.xy / 128.0;
	}
	if (an.x > 0.5) {
		return vec2(p.y, p.z) / 128.0;
	}
	return vec2(p.x, p.z) / 128.0;
}

float blockMortar(vec2 f, float width) {
	float edge = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));
	return 1.0 - smoothstep(width, width * 1.9, edge);
}

vec3 wallStoneTexture(vec2 uv, int rid, int kind) {
	vec2 brick = uv * vec2(0.82, 1.35);
	float row = floor(brick.y);
	brick.x += mod(row, 2.0) * 0.5;
	vec2 cell = floor(brick);
	vec2 f = fract(brick);
	float mortar = blockMortar(f, 0.045);
	float bevel = smoothstep(0.035, 0.18, min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y)));
	float grain = valueNoise(uv * 8.0) * 0.16 + valueNoise(uv * 27.0) * 0.06;
	float stone = 0.76 + hash21(cell + float(rid) * 19.0) * 0.18 + grain;
	float crackX = 1.0 - smoothstep(0.006, 0.018, abs(fract(uv.x * 5.0 + hash21(cell)) - 0.5));
	float crackY = 1.0 - smoothstep(0.006, 0.018, abs(fract(uv.y * 4.0 + hash21(cell.yx)) - 0.5));
	float cracks = max(crackX * step(0.76, hash21(cell + 3.0)), crackY * step(0.80, hash21(cell + 7.0))) * 0.18;
	vec3 base = vec3(0.30, 0.32, 0.23);
	if (kind == 3) {
		base = vec3(0.34, 0.27, 0.21);
	}
	vec3 roomTint = mix(vec3(1.0), roomColorById(rid), 0.035);
	vec3 color = base * roomTint * stone * mix(0.72, 1.0, bevel);
	color = mix(color, vec3(0.075, 0.080, 0.070), mortar);
	color *= 1.0 - cracks;
	return color;
}

vec3 slabStoneTexture(vec2 uv, int rid, int kind) {
	vec2 slab = uv * (kind == 0 ? vec2(1.0, 1.0) : vec2(0.72, 0.72));
	vec2 cell = floor(slab);
	vec2 f = fract(slab);
	float mortar = blockMortar(f, kind == 0 ? 0.035 : 0.050);
	float grain = valueNoise(uv * 10.0) * 0.18 + valueNoise(uv * 33.0) * 0.05;
	float stone = 0.70 + hash21(cell + float(rid) * 11.0) * 0.20 + grain;
	vec3 base = kind == 0 ? vec3(0.27, 0.32, 0.22) : vec3(0.22, 0.24, 0.19);
	vec3 roomTint = mix(vec3(1.0), roomColorById(rid), 0.030);
	vec3 color = base * roomTint * stone;
	color = mix(color, vec3(0.055, 0.060, 0.052), mortar);
	return color;
}

vec3 materialLightmapTint(vec3 p, vec3 n, int rid, int kind) {
	float height = clamp((p.z + 64.0) / 576.0, 0.0, 1.0);
	float lampBand = 0.5 + 0.5 * sin((p.x + p.y) * 0.008 + float(rid) * 1.7);
	vec3 roomTint = roomColorById(rid);
	vec3 bakedTint = mix(vec3(0.66, 0.70, 0.48), roomTint, kind == 0 ? 0.045 : 0.070);
	float baked = mix(0.52, 0.82, height) + lampBand * 0.06;
	if (kind == 0) {
		baked *= 0.82;
	}
	if (kind == 1) {
		baked *= 0.70;
	}
	return clamp(bakedTint * baked + vec3(0.045, 0.050, 0.035), 0.10, 0.78);
}

vec3 roomSurfaceColor(vec3 p, vec3 n, int kind) {
	int rid = roomIdForPoint(p - n * 2.0);
	vec2 uv = surfaceUv(p, n);
	vec3 procedural;
	if (kind == 0 || kind == 1) {
		procedural = slabStoneTexture(uv, rid, kind);
	} else {
		procedural = wallStoneTexture(uv, rid, kind);
	}

	vec3 texel = texture(roomTexture, uv).rgb;
	float whiteFallback = step(0.97, min(texel.r, min(texel.g, texel.b)));
	vec3 color = mix(texel, procedural, whiteFallback);
	vec3 detail = texture(detailTexture, uv * 16.0).rgb;
	float detailFallback = step(0.97, min(detail.r, min(detail.g, detail.b)));
	vec3 detailMod = mix(clamp(detail * 2.0, 0.45, 1.45), vec3(1.0), detailFallback);
	color *= mix(vec3(1.0), detailMod, 0.38);
	color = color * materialLightmapTint(p, n, rid, kind) * 1.08;
	float grime = 1.0 - valueNoise(vec2(uv.x * 0.45, uv.y * 1.20 + float(rid))) * 0.12;
	return clamp(color * grime + vec3(0.018, 0.016, 0.012), 0.0, 1.0);
}

bool intersectSphere(vec3 ro, vec3 rd, vec3 c, float r, out float tHit, out vec3 nHit) {
	vec3 oc = ro - c;
	float b = dot(oc, rd);
	float h = b * b - dot(oc, oc) + r * r;
	if (h < 0.0) {
		return false;
	}
	h = sqrt(h);
	float t = -b - h;
	if (t <= 0.0001) {
		t = -b + h;
	}
	if (t <= 0.0001) {
		return false;
	}
	tHit = t;
	nHit = normalize(ro + rd * t - c);
	return true;
}

int objectRoomId(int objectId) {
	return objectId == 0 ? 1 : (objectId == 2 ? 3 : 2);
}

vec3 objectCenter(int objectId) {
	if (objectId == 0) {
		return vec3(0.0, -1040.0, 160.0);
	}
	if (objectId == 2) {
		return vec3(0.0, 1040.0, 165.0);
	}
	return vec3(0.0, 0.0, 165.0);
}

vec3 objectTint(int objectId) {
	if (objectId == 0) {
		return vec3(1.00, 0.32, 0.08);
	}
	if (objectId == 2) {
		return vec3(0.20, 0.80, 1.30);
	}
	return vec3(1.00, 0.42, 0.08);
}

float southObjectDensity(vec3 p) {
	float core = 1.0 - length((p - vec3(0.0, -1040.0, 138.0)) / vec3(42.0, 42.0, 72.0));
	float crown = 1.0 - length((p - vec3(0.0, -1040.0, 222.0)) / vec3(28.0, 28.0, 30.0));
	float left = 1.0 - length((p - vec3(-48.0, -1084.0, 170.0)) / vec3(18.0, 18.0, 28.0));
	float right = 1.0 - length((p - vec3(48.0, -996.0, 170.0)) / vec3(18.0, 18.0, 28.0));
	return clamp(max(max(core, crown), max(left, right)), 0.0, 1.0);
}

float middleObjectDensity(vec3 p) {
	float body = 1.0 - length((p - vec3(0.0, 0.0, 145.0)) / vec3(48.0, 36.0, 58.0));
	float head = 1.0 - length((p - vec3(0.0, -28.0, 205.0)) / vec3(28.0, 24.0, 28.0));
	float leftWing = 1.0 - length((p - vec3(-56.0, 6.0, 175.0)) / vec3(24.0, 14.0, 62.0));
	float rightWing = 1.0 - length((p - vec3(56.0, 6.0, 175.0)) / vec3(24.0, 14.0, 62.0));
	float horns = max(1.0 - length((p - vec3(-14.0, -48.0, 232.0)) / vec3(8.0, 12.0, 18.0)),
	                  1.0 - length((p - vec3( 14.0, -48.0, 232.0)) / vec3(8.0, 12.0, 18.0)));
	return clamp(max(max(body, head), max(max(leftWing, rightWing), horns)), 0.0, 1.0);
}

float northObjectDensity(vec3 p) {
	float stem = 1.0 - length((p - vec3(0.0, 1040.0, 160.0)) / vec3(28.0, 42.0, 112.0));
	float cap = 1.0 - length((p - vec3(0.0, 1040.0, 260.0)) / vec3(22.0, 30.0, 32.0));
	float leftShard = 1.0 - length((p - vec3(-54.0, 1012.0, 145.0)) / vec3(18.0, 22.0, 68.0));
	float rightShard = 1.0 - length((p - vec3(58.0, 1070.0, 178.0)) / vec3(22.0, 18.0, 72.0));
	return clamp(max(max(stem, cap), max(leftShard, rightShard)), 0.0, 1.0);
}

float objectDensity(vec3 p, int objectId) {
	if (objectId == 0) {
		return southObjectDensity(p);
	}
	if (objectId == 2) {
		return northObjectDensity(p);
	}
	return middleObjectDensity(p);
}

vec3 objectEmission(vec3 p, int objectId) {
	float d = objectDensity(p, objectId);
	vec3 hot;
	if (objectId == 0) {
		hot = mix(vec3(0.50, 0.03, 0.01), vec3(2.60, 0.46, 0.08), d);
	} else if (objectId == 2) {
		hot = mix(vec3(0.01, 0.10, 0.24), vec3(0.20, 1.25, 3.00), d);
	} else {
		hot = mix(vec3(0.52, 0.05, 0.01), vec3(2.10, 0.72, 0.16), d);
	}
	float pulse = 0.85 + 0.15 * sin(neural.viewSeed.x * 4.0 + p.z * 0.035 + p.x * 0.02);
	return hot * d * pulse;
}

