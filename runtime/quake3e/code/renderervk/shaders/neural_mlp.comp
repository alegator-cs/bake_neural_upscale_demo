void fillReflectionDecalGeom(vec2 uv, vec3 surfaceRgb, vec3 volumeRgb, out float g[NEURAL_REFLECTION_DECAL_GEOM_INPUTS], out vec2 qRoi) {
	vec2 qSurface;
	vec2 qVolume;
	float ms = max(surfaceRgb.r, max(surfaceRgb.g, surfaceRgb.b)) > (3.0 / 255.0) ? 1.0 : 0.0;
	float mv = max(volumeRgb.r, max(volumeRgb.g, volumeRgb.b)) > (3.0 / 255.0) ? 1.0 : 0.0;
	float mu = 1.0 - (1.0 - ms) * (1.0 - mv);
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	vec3 virtualOrigin = neural.cameraOrigin.xyz;
	vec3 reflectedRay;
	int k = 0;

	virtualOrigin.x = 988.0 - virtualOrigin.x;
	virtualOrigin = (virtualOrigin - vec3(0.0, 0.0, 165.0)) / 576.0;
	reflectedRay = normalize(vec3(-rd.x, rd.y, rd.z));

	qRoi = reflectionDecalQ(uv, 0);
	qSurface = reflectionDecalQ(uv, 4) * ms;
	qVolume = reflectionDecalQ(uv, 8) * mv;

	g[k++] = qRoi.x;
	g[k++] = qRoi.y;
	g[k++] = qSurface.x;
	g[k++] = qSurface.y;
	g[k++] = qVolume.x;
	g[k++] = qVolume.y;
	g[k++] = ms;
	g[k++] = mv;
	g[k++] = mu;
	g[k++] = virtualOrigin.x;
	g[k++] = virtualOrigin.y;
	g[k++] = virtualOrigin.z;
	g[k++] = reflectedRay.x;
	g[k++] = reflectedRay.y;
	g[k++] = reflectedRay.z;
	g[k++] = 0.0;
	g[k++] = 0.0;
	g[k++] = 0.0;
	g[k++] = 0.0;
}

