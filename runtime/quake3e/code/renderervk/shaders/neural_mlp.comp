float relu(float x) {
	return max(x, 0.0);
}

float luminanceRgb(vec3 c) {
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float hash21(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}

float valueNoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash21(i);
	float b = hash21(i + vec2(1.0, 0.0));
	float c = hash21(i + vec2(0.0, 1.0));
	float d = hash21(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

vec3 evalFallback(vec2 uv) {
	float x0 = uv.x * 2.0 - 1.0;
	float x1 = uv.y * 2.0 - 1.0;
	vec4 h = vec4(
		relu( 1.7 * x0 - 0.9 * x1 + 0.10),
		relu(-1.1 * x0 + 1.4 * x1 + 0.20),
		relu( 0.8 * x0 + 0.6 * x1 - 0.15),
		relu(-0.4 * x0 - 0.7 * x1 + 0.35)
	);

	vec3 y = vec3(
		dot(h, vec4( 0.7, -0.2, 0.3,  0.1)) + 0.10,
		dot(h, vec4(-0.1,  0.6, 0.2,  0.4)) + 0.05,
		dot(h, vec4( 0.2,  0.1, 0.8, -0.3)) + 0.20
	);

	return clamp(y, 0.0, 1.0);
}

vec3 evalRoomNetworkInput(int roomIndex, vec2 networkInput) {
	int base = roomIndex * NEURAL_MLP_WEIGHT_COUNT;
	vec2 x = networkInput * 2.0 - 1.0;
	vec4 h;
	vec3 y;

	h.x = relu(dot(vec2(neural.weights[base + 0], neural.weights[base + 1]), x) + neural.weights[base + 8]);
	h.y = relu(dot(vec2(neural.weights[base + 2], neural.weights[base + 3]), x) + neural.weights[base + 9]);
	h.z = relu(dot(vec2(neural.weights[base + 4], neural.weights[base + 5]), x) + neural.weights[base + 10]);
	h.w = relu(dot(vec2(neural.weights[base + 6], neural.weights[base + 7]), x) + neural.weights[base + 11]);

	y.x = dot(h, vec4(neural.weights[base + 12], neural.weights[base + 13], neural.weights[base + 14], neural.weights[base + 15])) + neural.weights[base + 24];
	y.y = dot(h, vec4(neural.weights[base + 16], neural.weights[base + 17], neural.weights[base + 18], neural.weights[base + 19])) + neural.weights[base + 25];
	y.z = dot(h, vec4(neural.weights[base + 20], neural.weights[base + 21], neural.weights[base + 22], neural.weights[base + 23])) + neural.weights[base + 26];

	return clamp(y, 0.0, 1.0);
}

vec3 evalRoomNetwork(int roomIndex, vec2 uv) {
	return evalRoomNetworkInput(roomIndex, uv);
}

vec3 evalObjectNetworkInput(int objectIndex, vec2 networkInput) {
	int base = objectIndex * NEURAL_MLP_WEIGHT_COUNT;
	vec2 x = networkInput * 2.0 - 1.0;
	vec4 h;
	vec3 y;

	h.x = relu(dot(vec2(neural.objectWeights[base + 0], neural.objectWeights[base + 1]), x) + neural.objectWeights[base + 8]);
	h.y = relu(dot(vec2(neural.objectWeights[base + 2], neural.objectWeights[base + 3]), x) + neural.objectWeights[base + 9]);
	h.z = relu(dot(vec2(neural.objectWeights[base + 4], neural.objectWeights[base + 5]), x) + neural.objectWeights[base + 10]);
	h.w = relu(dot(vec2(neural.objectWeights[base + 6], neural.objectWeights[base + 7]), x) + neural.objectWeights[base + 11]);

	y.x = dot(h, vec4(neural.objectWeights[base + 12], neural.objectWeights[base + 13], neural.objectWeights[base + 14], neural.objectWeights[base + 15])) + neural.objectWeights[base + 24];
	y.y = dot(h, vec4(neural.objectWeights[base + 16], neural.objectWeights[base + 17], neural.objectWeights[base + 18], neural.objectWeights[base + 19])) + neural.objectWeights[base + 25];
	y.z = dot(h, vec4(neural.objectWeights[base + 20], neural.objectWeights[base + 21], neural.objectWeights[base + 22], neural.objectWeights[base + 23])) + neural.objectWeights[base + 26];

	return clamp(y, 0.0, 1.0);
}

vec3 evalReferenceNetwork(int roomId, vec2 uv) {
	vec2 x = uv * 2.0 - 1.0;
	vec4 h;
	vec3 y;

	if (roomId == 1) {
		h.x = relu(dot(vec2( 0.95, -0.20), x) + 0.22);
		h.y = relu(dot(vec2(-0.35,  0.70), x) + 0.10);
		h.z = relu(dot(vec2( 0.15, -1.10), x) + 0.24);
		h.w = relu(dot(vec2(-0.60, -0.35), x) + 0.08);
		y.x = dot(h, vec4(0.55, 0.10, 0.20, 0.14)) + 0.20;
		y.y = dot(h, vec4(0.18, 0.28, 0.10, 0.10)) + 0.08;
		y.z = dot(h, vec4(0.08, 0.08, 0.12, 0.06)) + 0.06;
		return clamp(y, 0.0, 1.0);
	}

	if (roomId == 3) {
		h.x = relu(dot(vec2(-0.40,  0.95), x) + 0.18);
		h.y = relu(dot(vec2( 0.80,  0.15), x) + 0.12);
		h.z = relu(dot(vec2(-0.85, -0.25), x) + 0.30);
		h.w = relu(dot(vec2( 0.20, -1.00), x) + 0.20);
		y.x = dot(h, vec4(0.08, 0.16, 0.12, 0.05)) + 0.05;
		y.y = dot(h, vec4(0.16, 0.28, 0.12, 0.20)) + 0.10;
		y.z = dot(h, vec4(0.48, 0.18, 0.38, 0.16)) + 0.22;
		return clamp(y, 0.0, 1.0);
	}

	h.x = relu(dot(vec2( 1.45, -0.35), x) + 0.12);
	h.y = relu(dot(vec2(-1.10,  0.95), x) + 0.22);
	h.z = relu(dot(vec2( 0.25,  1.30), x) - 0.04);
	h.w = relu(dot(vec2(-0.75, -0.85), x) + 0.30);
	y.x = dot(h, vec4(0.58, 0.06, 0.10, -0.03)) + 0.08;
	y.y = dot(h, vec4(0.10, 0.45, 0.18,  0.08)) + 0.11;
	y.z = dot(h, vec4(0.04, 0.16, 0.62,  0.20)) + 0.20;
	return clamp(y, 0.0, 1.0);
}

vec3 errorHeat(float error) {
	float e = clamp(error * 8.0, 0.0, 1.0);
	float red = smoothstep(0.35, 1.0, e);
	float green = smoothstep(0.05, 0.65, e) * (1.0 - smoothstep(0.75, 1.0, e));
	float blue = 1.0 - smoothstep(0.0, 0.45, e);

	return vec3(red, green, blue);
}

vec3 evalFuzz(vec2 uv, vec3 mlp, vec3 roomColor) {
	float pose = neural.viewSeed.y;
	float turn = neural.viewSeed.z;
	float strafe = neural.viewSeed.w;
	float t = neural.viewSeed.x;
	vec2 poseDrift = vec2(sin(pose * 0.37 + turn * 0.61), cos(pose * 0.29 - strafe * 0.43));
	vec2 viewDrift = vec2(sin(turn * 0.71 + strafe), cos(strafe * 0.53 - turn));
	vec2 warpedUv = uv + (mlp.gb - 0.5) * 0.12 + poseDrift * 0.19 + viewDrift * 0.10;
	vec2 coarseCell = floor(warpedUv * vec2(84.0, 48.0) + floor(vec2(pose, turn) * 23.0));
	vec2 fineCell = floor((warpedUv + mlp.rb * 0.25) * vec2(260.0, 148.0) + floor(vec2(turn, strafe) * 41.0));
	float coarse = hash21(coarseCell + floor(vec2(t * 5.0 + pose, t * 3.0 + turn)));
	float fine = hash21(fineCell + vec2(strafe * 29.0, pose * 17.0 + t * 23.0));
	float scan = sin((uv.x + mlp.r * 0.27 + turn * 0.11) * 90.0 + t * 5.5 + strafe * 1.3);
	float shimmer = smoothstep(0.15, 0.95, mix(coarse, fine, 0.45));
	vec3 poseTint = 0.5 + 0.5 * sin(vec3(0.0, 2.1, 4.2) + pose * 0.11 + turn * 0.37 + strafe * 0.23);
	vec3 base = mix(roomColor, mlp, 0.65);
	vec3 fuzz = vec3(
		shimmer,
		0.5 + 0.5 * scan,
		1.0 - shimmer
	);

	return clamp(base * (0.56 + 0.38 * shimmer) + fuzz * 0.24 + poseTint * 0.18 + vec3(scan) * 0.05, 0.0, 1.0);
}

