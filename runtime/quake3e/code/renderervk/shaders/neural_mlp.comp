float reflectionDecalAtlasFetch(int x, int y, int c) {
	int xx = clamp(x, 0, NEURAL_REFLECTION_DECAL_ATLAS_WIDTH - 1);
	int yy = clamp(y, 0, NEURAL_REFLECTION_DECAL_ATLAS_HEIGHT - 1);
