		reflectionDecalAtlasFetch(p0.x, p0.y, 0),
		reflectionDecalAtlasFetch(p0.x, p0.y, 1),
		reflectionDecalAtlasFetch(p0.x, p0.y, 2),
		reflectionDecalAtlasFetch(p0.x, p0.y, 3));
	vec4 c10 = vec4(
		reflectionDecalAtlasFetch(p1.x, p0.y, 0),
		reflectionDecalAtlasFetch(p1.x, p0.y, 1),
		reflectionDecalAtlasFetch(p1.x, p0.y, 2),
		reflectionDecalAtlasFetch(p1.x, p0.y, 3));
	vec4 c01 = vec4(
		reflectionDecalAtlasFetch(p0.x, p1.y, 0),
		reflectionDecalAtlasFetch(p0.x, p1.y, 1),
		reflectionDecalAtlasFetch(p0.x, p1.y, 2),
		reflectionDecalAtlasFetch(p0.x, p1.y, 3));
	vec4 c11 = vec4(
		reflectionDecalAtlasFetch(p1.x, p1.y, 0),
		reflectionDecalAtlasFetch(p1.x, p1.y, 1),
		reflectionDecalAtlasFetch(p1.x, p1.y, 2),
		reflectionDecalAtlasFetch(p1.x, p1.y, 3));
