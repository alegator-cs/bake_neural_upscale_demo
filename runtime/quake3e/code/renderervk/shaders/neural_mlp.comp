	for (int i = 0; i < NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2; i++) {
		blendLogit += colorH2[i] * neural.reflectionWeights[NEURAL_REFLECTION_DECAL_COLOR_W3_OFFSET + 0 * NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2 + i];
		residual.r += colorH2[i] * neural.reflectionWeights[NEURAL_REFLECTION_DECAL_COLOR_W3_OFFSET + 1 * NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2 + i];
		residual.g += colorH2[i] * neural.reflectionWeights[NEURAL_REFLECTION_DECAL_COLOR_W3_OFFSET + 2 * NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2 + i];
		residual.b += colorH2[i] * neural.reflectionWeights[NEURAL_REFLECTION_DECAL_COLOR_W3_OFFSET + 3 * NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2 + i];
	}

	beta = sigmoidReflection(blendLogit);
	ms = g[6];
	mv = g[7];
	ws = ms * beta;
	wv = mv * (1.0 - beta);
	baseRgb = (ws * surfaceRgb + wv * volumeRgb) / max(ws + wv, 0.000001);
	rgb = clamp(baseRgb + residual, 0.0, 1.0);

	return vec4(rgb, clamp(alpha, 0.0, 1.0));
}
#endif

vec4 evalReflectionDecalMlp(vec2 uv, vec3 surfaceRgb, vec3 volumeRgb) {
	float signal = max(max(surfaceRgb.r, max(surfaceRgb.g, surfaceRgb.b)), max(volumeRgb.r, max(volumeRgb.g, volumeRgb.b)));
	float alpha = smoothstep(2.0 / 255.0, 16.0 / 255.0, signal);
	return vec4(clamp(max(surfaceRgb, volumeRgb), 0.0, 1.0), alpha);
}

vec4 evalActiveReflectionMlp(vec2 uv, vec3 surfaceRgb, vec3 volumeRgb) {
	return evalReflectionDecalMlp(uv, surfaceRgb, volumeRgb);
}

vec4 renderExactDirectOverlay(vec2 uv, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit hit;

	if (!traceScene(ro, rd, 4, hit)) {
		outRoomId = roomIdForPoint(ro);
		return vec4(0.0);
	}

	outRoomId = hit.roomId;
	if (hit.materialId == 30) {
		return vec4(0.0);
	}

	if (!liveContributionMaterial(hit.materialId)) {
		float shadow = dynamicShadowAlpha(hit, 4);
		return shadow > 0.01 ? vec4(0.0, 0.0, 0.0, shadow) : vec4(0.0);
	}

	float alpha = hit.materialId >= 40 && hit.materialId <= 49 ? 0.84 : 0.96;
	float gain = hit.materialId >= 40 && hit.materialId <= 49 ? 0.74 : 0.88;
	return vec4(tonemapRt(shadeRay(ro, rd, 4) * gain), alpha);
}

vec4 renderActualObjectOverlay(vec2 uv, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit hit;

	outRoomId = roomIdForPoint(ro);
	hit.t = 100000.0;
	hit.p = vec3(0.0);
	hit.n = vec3(0.0, 0.0, 1.0);
	hit.baseColor = vec3(0.0);
	hit.emission = vec3(0.0);
	hit.reflective = 0.0;
	hit.roomId = outRoomId;
	hit.materialId = 0;

	if (!hitExactMiddleObject(ro, rd, hit)) {
		return vec4(0.0);
	}

	outRoomId = hit.roomId;
	return vec4(tonemapRt(shadeRay(ro, rd, 4) * 0.88), 0.96);
}

vec4 renderMode7SurfaceMirrorBaseline(vec2 uv, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit mirrorHit;
	RtHit objectHit;

	outRoomId = roomIdForPoint(ro);

	mirrorHit.t = 100000.0;
	mirrorHit.p = vec3(0.0);
	mirrorHit.n = vec3(0.0, 0.0, 1.0);
	mirrorHit.baseColor = vec3(0.0);
	mirrorHit.emission = vec3(0.0);
	mirrorHit.reflective = 0.0;
	mirrorHit.roomId = 2;
	mirrorHit.materialId = 0;
	hitMirror(ro, rd, mirrorHit);

	objectHit.t = 100000.0;
	objectHit.p = vec3(0.0);
	objectHit.n = vec3(0.0, 0.0, 1.0);
	objectHit.baseColor = vec3(0.0);
	objectHit.emission = vec3(0.0);
	objectHit.reflective = 0.0;
	objectHit.roomId = 2;
	objectHit.materialId = 0;
	if (hitExactMiddleObject(ro, rd, objectHit) && objectHit.t < mirrorHit.t - 0.5) {
		outRoomId = objectHit.roomId;
		return vec4(tonemapRt(shadeRay(ro, rd, 4) * 0.88), 0.96);
	}

	if (mirrorHit.t < 100000.0) {
		outRoomId = mirrorHit.roomId;
		return mirrorSurfaceMiddleOverlay(mirrorHit, rd, uv);
	}

	return vec4(0.0);
}

vec4 renderReflectionMlpCorrected(vec2 uv, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit mirrorHit;
	RtHit objectHit;
	vec4 result = vec4(0.0);
	vec4 actual = renderActualObjectOverlay(uv, outRoomId);
	vec4 surface;
	vec4 volume;
	vec4 pred;
	vec3 paint;
	vec3 premulPaint;
	float mask;
	float paintAlpha;
	float paintSignal;
	float inputSignal;
	int mlpMode;
	int modeRoomId;

	mirrorHit.t = 100000.0;
	mirrorHit.p = vec3(0.0);
	mirrorHit.n = vec3(0.0, 0.0, 1.0);
	mirrorHit.baseColor = vec3(0.0);
	mirrorHit.emission = vec3(0.0);
	mirrorHit.reflective = 0.0;
	mirrorHit.roomId = 2;
	mirrorHit.materialId = 0;
	if (!hitMirror(ro, rd, mirrorHit)) {
		return actual;
	}

	objectHit.t = 100000.0;
	objectHit.p = vec3(0.0);
	objectHit.n = vec3(0.0, 0.0, 1.0);
	objectHit.baseColor = vec3(0.0);
	objectHit.emission = vec3(0.0);
	objectHit.reflective = 0.0;
	objectHit.roomId = roomIdForPoint(ro);
	objectHit.materialId = 0;
	if (hitExactObjects(ro, rd, objectHit) && objectHit.t < mirrorHit.t - 0.5) {
		return actual;
	}

	outRoomId = mirrorHit.roomId;
	result = compositeOverlay(actual, mirrorPanelOverlay(mirrorHit, rd, uv));

	surface = renderMirrorOnlyMode(uv, 5, modeRoomId);
	volume = renderMirrorOnlyMode(uv, 6, modeRoomId);
	inputSignal = reflectionInputSignal(surface, volume);
	if (!reflectionMlpLoaded() || !neuralMlpEnabled() || !reflectionInsideSelectedBounds(uv)) {
		return compositeOverlay(result, mirrorFrameOverlay(mirrorHit));
	}
	if (!reflectionDecalLoaded() && inputSignal <= (3.0 / 255.0)) {
		return compositeOverlay(result, mirrorFrameOverlay(mirrorHit));
	}

	pred = evalActiveReflectionMlp(uv, surface.rgb, volume.rgb);
	paint = clamp(pred.rgb, 0.0, 1.0);
	mask = clamp(pred.a, 0.0, 1.0);
	premulPaint = paint * mask;
	paintSignal = max(premulPaint.r, max(premulPaint.g, premulPaint.b));
	paintAlpha = smoothstep(2.0 / 255.0, 8.0 / 255.0, paintSignal);
	mlpMode = neuralMlpMode();

	if (mlpMode == 2) {
		return compositeOverlay(compositeOverlay(result, vec4(vec3(mask), 0.85)), mirrorFrameOverlay(mirrorHit));
	}
	if (mlpMode == 3) {
		result = paintSignal > (1.0 / 255.0) ? compositeOverlay(result, vec4(premulPaint, 0.85)) : result;
		return compositeOverlay(result, mirrorFrameOverlay(mirrorHit));
	}

	if (paintAlpha <= 0.001) {
		return compositeOverlay(result, mirrorFrameOverlay(mirrorHit));
	}

	return compositeOverlay(compositeOverlay(result, vec4(premulPaint, paintAlpha)), mirrorFrameOverlay(mirrorHit));
}

vec4 renderReflectionMlpError(vec2 uv, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit mirrorHit;

	outRoomId = roomIdForPoint(ro);
	mirrorHit.t = 100000.0;
	mirrorHit.p = vec3(0.0);
	mirrorHit.n = vec3(0.0, 0.0, 1.0);
	mirrorHit.baseColor = vec3(0.0);
	mirrorHit.emission = vec3(0.0);
	mirrorHit.reflective = 0.0;
	mirrorHit.roomId = 2;
	mirrorHit.materialId = 0;
	if (!hitMirror(ro, rd, mirrorHit) ||
			!reflectionMlpLoaded() || !neuralMlpEnabled() || !reflectionInsideSelectedBounds(uv)) {
		return vec4(0.0);
	}
	outRoomId = mirrorHit.roomId;

	int modeRoomId;
	vec4 surface = renderMirrorOnlyMode(uv, 5, modeRoomId);
	vec4 volume = renderMirrorOnlyMode(uv, 6, modeRoomId);
	vec4 exact = renderMirrorOnlyMode(uv, 4, modeRoomId);
	vec4 pred = evalActiveReflectionMlp(uv, surface.rgb, volume.rgb);
	vec3 predPremul = clamp(pred.rgb, 0.0, 1.0) * clamp(pred.a, 0.0, 1.0);
	vec3 exactPremul = exact.rgb * exact.a;
	vec3 delta = abs(predPremul - exactPremul);
	float e = max(delta.x, max(delta.y, delta.z));
	if (e < 0.015 && max(max(predPremul.r, max(predPremul.g, predPremul.b)), max(exactPremul.r, max(exactPremul.g, exactPremul.b))) < 0.02) {
		return vec4(0.0);
	}
	return vec4(errorHeat(e), 0.85);
}

vec4 renderReflectionMlpInputView(vec2 uv, int inputMode, out int outRoomId) {
	int modeRoomId;
	vec4 inputColor;

	outRoomId = roomIdForPoint(neural.cameraOrigin.xyz);

	inputColor = renderMirrorOnlyMode(uv, inputMode, modeRoomId);
	outRoomId = modeRoomId;
	return vec4(inputColor.rgb, 1.0);
}

vec4 renderReflectionMlpOutputView(vec2 uv, out int outRoomId) {
	int modeRoomId;
	int mlpMode;
	vec4 surface;
	vec4 volume;
	vec4 pred;
	float proxySignal;
	float proxyMask;

	outRoomId = roomIdForPoint(neural.cameraOrigin.xyz);
	mlpMode = neuralMlpMode();
	if (mlpMode == 5) {
		vec3 bars = vec3(uv.x, uv.y, 0.5 + 0.5 * sin((uv.x + uv.y) * 40.0));
		return vec4(bars, 1.0);
	}

	surface = renderMirrorOnlyMode(uv, 5, modeRoomId);
	volume = renderMirrorOnlyMode(uv, 6, modeRoomId);
	outRoomId = modeRoomId;
	proxySignal = max(max(surface.r, max(surface.g, surface.b)), max(volume.r, max(volume.g, volume.b)));
	proxyMask = smoothstep(2.0 / 255.0, 24.0 / 255.0, proxySignal);

	if (mlpMode == 4) {
		return vec4(clamp(max(surface.rgb, volume.rgb), vec3(0.0), vec3(1.0)), 1.0);
	}
	if (mlpMode == 6) {
		vec3 proxyColor = mix(vec3(0.02, 0.0, 0.08), vec3(0.0, 1.0, 0.35), smoothstep(2.0 / 255.0, 24.0 / 255.0, proxySignal));
		return vec4(proxyColor, 1.0);
	}
	if (mlpMode == 7) {
		return vec4(neural.reflectionMeta.x != 0 ? 1.0 : 0.0, 0.55, neuralMlpEnabled() ? 1.0 : 0.0, 1.0);
	}
	if (mlpMode == 1) {
		return vec4(mix(vec3(0.04, 0.0, 0.06), vec3(1.0, 0.12, 0.85), proxyMask), 1.0);
	}
	if (!reflectionMlpLoaded() || !neuralMlpEnabled()) {
		return vec4(0.0, 0.0, 0.0, 1.0);
	}

	pred = evalActiveReflectionMlp(uv, surface.rgb, volume.rgb);

	if (mlpMode == 2) {
		return vec4(vec3(clamp(pred.a, 0.0, 1.0)), 1.0);
	}
	if (mlpMode == 3) {
		return vec4(clamp(pred.rgb, 0.0, 1.0), 1.0);
	}
	return vec4(clamp(pred.rgb * pred.a, 0.0, 1.0), 1.0);
}

vec4 renderCorrectedObjects(vec2 uv, out int outRoomId) {
	vec4 correction;
	vec4 exact;
	int objectIndex;
	if (reflectionMlpLoaded()) {
		return renderReflectionMlpCorrected(uv, outRoomId);
	}
	return renderMode7SurfaceMirrorBaseline(uv, outRoomId);
	if (!renderObjectCorrection(uv, correction, exact, outRoomId, objectIndex)) {
		return vec4(0.0);
	}
	return correction;
}

vec4 renderCorrectionError(vec2 uv, out int outRoomId) {
	vec4 correction;
	vec4 exact;
	int objectIndex;
	vec3 scene;
	vec3 correctedFinal;
	vec3 exactFinal;
	vec3 delta;
	if (reflectionMlpLoaded()) {
		return renderReflectionMlpError(uv, outRoomId);
	}
	if (!renderObjectCorrection(uv, correction, exact, outRoomId, objectIndex)) {
		return vec4(0.0);
	}
	scene = texture(sceneColor, uv).rgb;
	correctedFinal = mix(scene, correction.rgb, clamp(correction.a, 0.0, 1.0));
	exactFinal = mix(scene, exact.rgb, clamp(exact.a, 0.0, 1.0));
	delta = abs(correctedFinal - exactFinal);
	return vec4(errorHeat(max(delta.x, max(delta.y, delta.z))), 0.90);
}

int roomIndexForUv(vec2 uv) {
	int count = clamp(neural.roomCount, 0, MAX_NEURAL_ROOMS);

	if (count <= 0) {
		return -1;
	}
	if (neural.activeRoom >= 0 && neural.activeRoom < count) {
		return neural.activeRoom;
	}
	if (count == 1) {
		return 0;
	}
	if (uv.y < 0.333333) {
		return 0;
	}
	if (uv.y < 0.666667) {
		return min(1, count - 1);
	}
	return min(2, count - 1);
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outHDR);
	int roomIndex;
	float encodedRoomId;
	vec3 y;
	vec3 roomTint;
	vec3 reference;
	vec3 delta;
	int liveRoomId;

	if (p.x >= size.x || p.y >= size.y) {
		return;
	}

	vec2 uv = (vec2(p) + vec2(0.5)) / vec2(size);

	if (neural.viewMode >= 1 && neural.viewMode <= 8) {
		vec4 live = neural.viewMode == 1 ? renderLiveMode(uv, 5, liveRoomId) :
			(neural.viewMode == 2 ? renderLiveMode(uv, 6, liveRoomId) :
			(neural.viewMode == 3 ? renderLiveMode(uv, 4, liveRoomId) :
			(neural.viewMode == 4 ? renderReflectionMlpInputView(uv, 5, liveRoomId) :
			(neural.viewMode == 5 ? renderReflectionMlpInputView(uv, 6, liveRoomId) :
			(neural.viewMode == 6 ? renderReflectionMlpOutputView(uv, liveRoomId) :
			(neural.viewMode == 7 ? renderCorrectedObjects(uv, liveRoomId) : renderCorrectionError(uv, liveRoomId)))))));
		if (neural.viewMode <= 8) {
			live = compositeOverlay(live, renderActiveMarkerOverlay(uv));
		}
		imageStore(outHDR, p, live);
		imageStore(outRoomId, p, vec4(float(liveRoomId) / 255.0, 0.0, 0.0, 1.0));
		return;
	}

	roomIndex = roomIndexForUv(uv);

	if (roomIndex >= 0) {
		encodedRoomId = float(neural.roomId[roomIndex]) / 255.0;
		roomTint = neural.roomColor[roomIndex].rgb;
		if (neural.hasWeights[roomIndex] != 0) {
			y = evalRoomNetwork(roomIndex, uv);
		} else {
			y = roomTint;
		}
	} else {
		encodedRoomId = uv.y < 0.333333 ? 1.0 / 255.0 : (uv.y < 0.666667 ? 2.0 / 255.0 : 3.0 / 255.0);
		y = evalFallback(uv);
		roomTint = y;
	}

	if (neural.viewMode == 2) {
		int referenceRoomId = roomIndex >= 0 ? neural.roomId[roomIndex] : (uv.y < 0.333333 ? 1 : (uv.y < 0.666667 ? 2 : 3));
		reference = evalReferenceNetwork(referenceRoomId, uv);
		delta = abs(y - reference);
		y = errorHeat(max(delta.x, max(delta.y, delta.z)));
	} else if (neural.viewMode == 3) {
		y = evalFuzz(uv, y, roomTint);
	}

	imageStore(outHDR, p, vec4(y, 1.0));
	imageStore(outRoomId, p, vec4(encodedRoomId, 0.0, 0.0, 1.0));
}
