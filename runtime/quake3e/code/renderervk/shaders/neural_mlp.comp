vec4 evalReflectionMlp(vec2 uv, vec3 surfaceRgb, vec3 volumeRgb) {
	float f[NEURAL_REFLECTION_INPUTS];
	float h1[NEURAL_REFLECTION_HIDDEN];
	float h2[NEURAL_REFLECTION_HIDDEN];
	float omega = neural.reflectionParams.x;

	fillReflectionFeatures(uv, surfaceRgb, volumeRgb, f);

	for (int j = 0; j < NEURAL_REFLECTION_HIDDEN; j++) {
		float sum = neural.reflectionWeights[NEURAL_REFLECTION_B1_OFFSET + j];
		for (int i = 0; i < NEURAL_REFLECTION_INPUTS; i++) {
			sum += f[i] * neural.reflectionWeights[NEURAL_REFLECTION_W1_OFFSET + i * NEURAL_REFLECTION_HIDDEN + j];
		}
		h1[j] = sin(omega * sum);
	}

	for (int j = 0; j < NEURAL_REFLECTION_HIDDEN; j++) {
		float sum = neural.reflectionWeights[NEURAL_REFLECTION_B2_OFFSET + j];
		for (int i = 0; i < NEURAL_REFLECTION_HIDDEN; i++) {
			sum += h1[i] * neural.reflectionWeights[NEURAL_REFLECTION_W2_OFFSET + i * NEURAL_REFLECTION_HIDDEN + j];
		}
		h2[j] = sin(omega * sum);
	}

	vec4 outv;
	for (int j = 0; j < NEURAL_REFLECTION_OUTPUTS; j++) {
		float sum = neural.reflectionWeights[NEURAL_REFLECTION_B3_OFFSET + j];
		for (int i = 0; i < NEURAL_REFLECTION_HIDDEN; i++) {
			sum += h2[i] * neural.reflectionWeights[NEURAL_REFLECTION_W3_OFFSET + i * NEURAL_REFLECTION_OUTPUTS + j];
		}
		outv[j] = sigmoidReflection(sum);
	}
	return clamp(outv, 0.0, 1.0);
}

