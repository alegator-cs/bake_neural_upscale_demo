	float g[NEURAL_REFLECTION_DECAL_GEOM_INPUTS];
	float alphaIn[20];
	float colorIn[28];
	float alphaH[NEURAL_REFLECTION_DECAL_ALPHA_HIDDEN];
	float colorH1[NEURAL_REFLECTION_DECAL_COLOR_HIDDEN1];
	float colorH2[NEURAL_REFLECTION_DECAL_COLOR_HIDDEN2];
