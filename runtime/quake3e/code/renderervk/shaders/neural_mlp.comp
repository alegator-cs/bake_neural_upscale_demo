void surfaceProxyBounds(int objectId, out vec3 mn, out vec3 mx) {
	if (objectId == 0) {
		mn = vec3(-76.0, -1052.0, 70.0);
		mx = vec3( 76.0, -1028.0, 246.0);
		return;
	}
	if (objectId == 2) {
		mn = vec3(-72.0, 1028.0, 70.0);
		mx = vec3( 72.0, 1052.0, 262.0);
		return;
	}
	mn = vec3(-78.0, -12.0, 88.0);
	mx = vec3( 78.0,  12.0, 246.0);
}

vec3 surfaceProxyColor(vec3 p, int objectId) {
	vec3 c = objectCenter(objectId);
	vec2 q = vec2((p.x - c.x) / 150.0, (p.z - c.z) / 128.0);
	if (objectId == 0) {
		float core = smoothstep(0.72, 0.14, length(q - vec2(0.0, -0.16)));
		float crown = smoothstep(0.38, 0.06, length(q - vec2(0.0, 0.48)));
		float sparks = smoothstep(0.16, 0.02, abs(abs(q.x) - 0.36)) * smoothstep(0.70, 0.08, abs(q.y - 0.08));
		float mask = clamp(max(max(core, crown), sparks), 0.0, 1.0);
		return mix(vec3(0.34, 0.035, 0.01), vec3(2.10, 0.42, 0.06), mask) * (0.18 + 0.72 * mask);
	}
	if (objectId == 2) {
		float stem = smoothstep(0.30, 0.04, abs(q.x)) * smoothstep(1.02, 0.05, abs(q.y));
		float shards = smoothstep(0.15, 0.02, abs(abs(q.x) - 0.42)) * smoothstep(0.92, 0.10, abs(q.y + 0.02));
		float cap = smoothstep(0.34, 0.05, length(q - vec2(0.0, 0.74)));
		float mask = clamp(max(max(stem, shards), cap), 0.0, 1.0);
		return mix(vec3(0.01, 0.08, 0.26), vec3(0.14, 0.82, 2.10), mask) * (0.20 + 0.72 * mask);
	}
	float head = smoothstep(0.55, 0.18, length(q - vec2(0.0, 0.35)));
	float body = smoothstep(0.72, 0.20, length(q - vec2(0.0, -0.15)));
	float wings = smoothstep(0.34, 0.03, abs(abs(q.x) - 0.58)) * smoothstep(0.88, 0.08, abs(q.y + 0.05));
	float mask = clamp(max(max(head, body), wings), 0.0, 1.0);
	return mix(vec3(0.24, 0.025, 0.01), vec3(1.90, 0.62, 0.10), mask) * (0.18 + 0.72 * mask);
}

bool hitSurfaceProxyObject(vec3 ro, vec3 rd, int objectId, inout RtHit hit) {
	float t;
	vec3 n;
	vec3 mn;
	vec3 mx;

	surfaceProxyBounds(objectId, mn, mx);
	if (intersectBox(ro, rd, mn, mx, t, n) && t < hit.t) {
		hit.t = t;
		hit.p = ro + rd * t;
		hit.n = n;
		hit.baseColor = objectTint(objectId) * 0.70;
		hit.emission = surfaceProxyColor(hit.p, objectId);
		hit.reflective = 0.18;
		hit.roomId = objectRoomId(objectId);
		hit.materialId = 40 + objectId;
		return true;
	}

	return false;
}

bool hitSurfaceProxies(vec3 ro, vec3 rd, inout RtHit hit) {
	bool found = false;
	for (int objectId = 0; objectId < 3; objectId++) {
		if (hitSurfaceProxyObject(ro, rd, objectId, hit)) {
			found = true;
		}
	}
	return found;
}

bool hitMirror(vec3 ro, vec3 rd, inout RtHit hit) {
	vec3 p0 = vec3(494.0, 0.0, 240.0);
	vec3 n = vec3(-1.0, 0.0, 0.0);
	float denom = dot(rd, n);
	if (abs(denom) < 0.000001) {
		return false;
	}
	float t = dot(p0 - ro, n) / denom;
	if (t <= 0.0001 || t >= hit.t) {
		return false;
	}
	vec3 p = ro + rd * t;
	vec2 local = vec2(p.y, p.z - 240.0);
	if (abs(local.x) > 384.0 || abs(local.y) > 192.0) {
		return false;
	}
	hit.t = t;
	hit.p = p;
	hit.n = denom < 0.0 ? n : -n;
	hit.baseColor = vec3(0.76, 0.90, 1.0);
	hit.emission = vec3(0.0);
	hit.reflective = 0.86;
	hit.roomId = 2;
	hit.materialId = 30;
	return true;
}

bool traceScene(vec3 ro, vec3 rd, int mode, out RtHit hit) {
	bool found = false;
	hit.t = 100000.0;
	hit.p = vec3(0.0);
	hit.n = vec3(0.0, 0.0, 1.0);
	hit.baseColor = vec3(0.0);
	hit.emission = vec3(0.0);
	hit.reflective = 0.0;
	hit.roomId = roomIdForPoint(ro);
	hit.materialId = 0;

	for (int i = 0; i < 20; i++) {
		vec3 mn, mx, n;
		int kind;
		float t;
		roomBox(i, mn, mx, kind);
		if (intersectBox(ro, rd, mn, mx, t, n) && t < hit.t) {
			hit.t = t;
			hit.p = ro + rd * t;
			hit.n = n;
			hit.baseColor = roomSurfaceColor(hit.p, n, kind);
			hit.emission = vec3(0.0);
			hit.reflective = 0.0;
			hit.roomId = roomIdForPoint(hit.p - n * 2.0);
			hit.materialId = kind + 1;
			found = true;
		}
	}

	if (hitMirror(ro, rd, hit)) {
		found = true;
	}
	if (mode == 4 && hitExactObjects(ro, rd, hit)) {
		found = true;
	}
	if (mode == 5 && hitSurfaceProxies(ro, rd, hit)) {
		found = true;
	}
	return found;
}

bool shadowed(vec3 p, vec3 lpos, int mode) {
	vec3 toL = lpos - p;
	float maxT = length(toL);
	vec3 dir = toL / max(maxT, 0.0001);
	RtHit sh;
	if (!traceScene(p + dir * 1.5, dir, mode, sh)) {
		return false;
	}
	return sh.t < maxT - 3.0 && sh.materialId != 30;
}

vec3 shadeDirect(RtHit hit, vec3 rd, int mode) {
	vec3 roomTint = roomColorById(hit.roomId);
	vec3 keyDir = normalize(vec3(-0.35, 0.45, 0.82));
	vec3 fillDir = normalize(vec3(0.60, -0.25, 0.45));
	float key = max(dot(hit.n, keyDir), 0.0);
	float fill = max(dot(hit.n, fillDir), 0.0);
	float upLight = 0.35 + 0.35 * max(hit.n.z, 0.0);
	vec3 color = hit.baseColor * (0.12 + 0.07 * roomTint + key * 0.18 + fill * 0.08 + upLight * 0.08) + hit.emission;
	for (int i = 0; i < 6; i++) {
		vec3 lp = lightPosition(i);
		vec3 toL = lp - hit.p;
		float dist2 = max(dot(toL, toL), 1.0);
		vec3 ldir = normalize(toL);
		float ndotl = max(dot(hit.n, ldir), 0.0);
		if (ndotl <= 0.0 || shadowed(hit.p + hit.n * 1.0, lp, mode)) {
			continue;
		}
		float falloff = lightIntensity(i) / (dist2 * 0.10);
		vec3 halfV = normalize(ldir - rd);
		float spec = pow(max(dot(hit.n, halfV), 0.0), hit.reflective > 0.0 ? 80.0 : 32.0) * falloff * (0.10 + hit.reflective * 0.35);
		color += hit.baseColor * lightColor(i) * ndotl * falloff + lightColor(i) * spec;
	}
	return color;
}

vec3 shadeRay(vec3 ro, vec3 rd, int mode) {
	vec3 accum = vec3(0.0);
	vec3 throughput = vec3(1.0);
	vec3 rayOrigin = ro;
	vec3 rayDir = rd;

	for (int bounce = 0; bounce < 3; bounce++) {
		RtHit hit;
		if (!traceScene(rayOrigin, rayDir, mode, hit)) {
			accum += throughput * vec3(0.015, 0.020, 0.030);
			break;
		}
		vec3 direct = shadeDirect(hit, rayDir, mode);
		float facing = max(dot(-rayDir, hit.n), 0.0);
		float fresnel = pow(1.0 - facing, 5.0);
		float mixFactor = min(1.0, hit.reflective * (0.45 + 0.55 * fresnel));
		accum += throughput * direct * (1.0 - mixFactor);

		if (mixFactor <= 0.001) {
			break;
		}
		throughput *= mixFactor;
		rayDir = normalize(reflect(rayDir, hit.n));
		rayOrigin = hit.p + rayDir * 1.5;
	}
	return accum;
}

vec3 tonemapRt(vec3 c);

bool intersectBoxRange(vec3 ro, vec3 rd, vec3 mn, vec3 mx, out float tNear, out float tFar) {
	tNear = -100000.0;
	tFar = 100000.0;

	for (int a = 0; a < 3; a++) {
		if (abs(rd[a]) < 0.0000001) {
			if (ro[a] < mn[a] || ro[a] > mx[a]) {
				return false;
			}
		} else {
			float t1 = (mn[a] - ro[a]) / rd[a];
			float t2 = (mx[a] - ro[a]) / rd[a];
			if (t1 > t2) {
				float tv = t1; t1 = t2; t2 = tv;
			}
			tNear = max(tNear, t1);
			tFar = min(tFar, t2);
			if (tNear > tFar) {
				return false;
			}
		}
	}

	return tFar > 0.0001;
}

void volumeProxyBounds(int objectId, out vec3 mn, out vec3 mx) {
	if (objectId == 0) {
		mn = vec3(-160.0, -1190.0, 35.0);
		mx = vec3( 160.0,  -890.0, 315.0);
		return;
	}
	if (objectId == 2) {
		mn = vec3(-160.0,  900.0, 35.0);
		mx = vec3( 160.0, 1190.0, 335.0);
		return;
	}
	mn = vec3(-190.0, -170.0, 35.0);
	mx = vec3( 190.0,  210.0, 335.0);
}

bool insideBounds(vec3 p, vec3 mn, vec3 mx) {
	return all(greaterThanEqual(p, mn)) && all(lessThanEqual(p, mx));
}

vec3 volumeCellPoint(vec3 p, int objectId) {
	vec3 mn;
	vec3 mx;
	volumeProxyBounds(objectId, mn, mx);
	vec3 cell = floor((p - mn) / 36.0);
	return mn + (cell + vec3(0.5)) * 36.0;
}

float volumeObjectDensity(vec3 p, int objectId) {
	vec3 mn;
	vec3 mx;
	volumeProxyBounds(objectId, mn, mx);
	if (!insideBounds(p, mn, mx)) {
		return 0.0;
	}
	vec3 cp = volumeCellPoint(p, objectId);
	vec3 center = objectCenter(objectId);
	vec3 plumeScale = objectId == 0 ? vec3(135.0, 130.0, 165.0) : (objectId == 2 ? vec3(130.0, 135.0, 175.0) : vec3(170.0, 150.0, 170.0));
	float plume = 1.0 - length((cp - (center + vec3(0.0, objectId == 0 ? 8.0 : 10.0, 18.0))) / plumeScale);
	float density = max(objectDensity(cp, objectId), 0.52 * clamp(plume, 0.0, 1.0));
	return smoothstep(0.05, 0.85, density);
}

vec3 volumeObjectEmission(vec3 p, int objectId, float density) {
	vec3 cp = volumeCellPoint(p, objectId);
	vec3 tint = objectTint(objectId);
	return objectEmission(cp, objectId) * 0.42 + tint * density * 0.32 + vec3(0.04, 0.08, 0.12) * density;
}

float volumeProxySample(vec3 p, out vec3 emission) {
	emission = vec3(0.0);
	float densityMax = 0.0;
	for (int objectId = 0; objectId < 3; objectId++) {
		float density = volumeObjectDensity(p, objectId);
		if (density > 0.0) {
			emission += volumeObjectEmission(p, objectId, density);
			densityMax = max(densityMax, density);
		}
	}
	return densityMax;
}

float volumeProxySampleObject(vec3 p, int objectId, out vec3 emission) {
	float density = volumeObjectDensity(p, objectId);
	emission = density > 0.0 ? volumeObjectEmission(p, objectId, density) : vec3(0.0);
	return density;
}

vec4 shadeVolumeProxyRaw(vec3 ro, vec3 rd, float tMax) {
	float t0 = 0.0;
	float t1 = min(tMax, 1900.0);
	if (t1 <= t0) {
		return vec4(0.0);
	}

	vec3 accum = vec3(0.0);
	float trans = 1.0;
	for (int i = 0; i < 64; i++) {
		float u = (float(i) + 0.5) / 64.0;
		float t = mix(t0, t1, u);
		vec3 p = ro + rd * t;
		vec3 emit;
		float density = volumeProxySample(p, emit);
		if (density <= 0.0) {
			continue;
		}
		float alpha = clamp(density * 0.10, 0.0, 0.34);
		accum += trans * alpha * emit;
		trans *= 1.0 - alpha;
		if (trans < 0.03) {
			break;
		}
	}

	float alpha = clamp((1.0 - trans) * 1.25, 0.0, 0.72);
	if (alpha <= 0.01) {
		return vec4(0.0);
	}

	vec3 color = accum / max(alpha, 0.08) * 1.8;
	return vec4(color, alpha);
}

vec4 shadeVolumeProxyObjectRaw(vec3 ro, vec3 rd, int objectId, float tMax) {
	float t0 = 0.0;
	float t1 = min(tMax, 1900.0);
	if (t1 <= t0) {
		return vec4(0.0);
	}

	vec3 accum = vec3(0.0);
	float trans = 1.0;
	for (int i = 0; i < 64; i++) {
		float u = (float(i) + 0.5) / 64.0;
		float t = mix(t0, t1, u);
		vec3 p = ro + rd * t;
		vec3 emit;
		float density = volumeProxySampleObject(p, objectId, emit);
		if (density <= 0.0) {
			continue;
		}
		float alpha = clamp(density * 0.10, 0.0, 0.34);
		accum += trans * alpha * emit;
		trans *= 1.0 - alpha;
		if (trans < 0.03) {
			break;
		}
	}

	float alpha = clamp((1.0 - trans) * 1.25, 0.0, 0.72);
	if (alpha <= 0.01) {
		return vec4(0.0);
	}

	vec3 color = accum / max(alpha, 0.08) * 1.8;
	return vec4(color, alpha);
}

vec4 shadeVolumeOverlay(vec3 ro, vec3 rd) {
	RtHit roomHit;
	bool hasHit = traceScene(ro, rd, 0, roomHit);
	float tMax = hasHit ? roomHit.t : 1800.0;
	vec4 volume = shadeVolumeProxyRaw(ro, rd, tMax);
	return volume.a > 0.01 ? vec4(tonemapRt(volume.rgb), volume.a) : vec4(0.0);
}

bool hitVolumeProxyShadowCaster(vec3 ro, vec3 rd, float maxT) {
	vec4 volume = shadeVolumeProxyRaw(ro, rd, maxT);
	return volume.a > 0.10;
}

vec3 tonemapRt(vec3 c) {
	c = max(c, vec3(0.0));
	c = c / (vec3(1.0) + c);
	return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
}

bool liveContributionMaterial(int materialId) {
	return materialId == 30 || (materialId >= 10 && materialId <= 29) || (materialId >= 40 && materialId <= 49);
}

bool roomSurfaceMaterial(int materialId) {
	return materialId >= 1 && materialId <= 4;
}

bool projectToCurrentView(vec3 worldPoint, out vec2 uv) {
	vec3 rel = worldPoint - neural.cameraOrigin.xyz;
	float z = dot(rel, neural.cameraForward.xyz);
	if (z <= 1.0) {
		uv = vec2(0.0);
		return false;
	}

	vec3 q = rel / z - neural.cameraForward.xyz;
	vec3 right = neural.cameraRight.xyz;
	vec3 up = neural.cameraUp.xyz;
	float rightLen = max(length(right), 0.0001);
	float upLen = max(length(up), 0.0001);
	float ndcX = dot(q, right / rightLen) / rightLen;
	float ndcY = dot(q, up / upLen) / upLen;
	uv = vec2(ndcX * 0.5 + 0.5, 0.5 - ndcY * 0.5);
	return all(greaterThanEqual(uv, vec2(0.002))) && all(lessThanEqual(uv, vec2(0.998)));
}

vec3 sceneColorAtWorld(vec3 worldPoint, vec3 fallback, float mixAmount) {
	vec2 sceneUv;
	if (!projectToCurrentView(worldPoint, sceneUv)) {
		return fallback;
	}

	vec3 sampled = texture(sceneColor, sceneUv).rgb;
	if (dot(sampled, sampled) < 0.0005) {
		return fallback;
	}

	return mix(fallback, sampled, mixAmount);
}

bool hitDynamicShadowCaster(vec3 ro, vec3 rd, float maxT, int mode) {
	RtHit sh;
	sh.t = maxT;
	sh.p = vec3(0.0);
	sh.n = vec3(0.0, 0.0, 1.0);
	sh.baseColor = vec3(0.0);
	sh.emission = vec3(0.0);
	sh.reflective = 0.0;
	sh.roomId = roomIdForPoint(ro);
	sh.materialId = 0;

	if (mode == 4 && hitExactObjects(ro, rd, sh) && sh.t < maxT) {
		return true;
	}
	if (mode == 5 && hitSurfaceProxies(ro, rd, sh) && sh.t < maxT) {
		return true;
	}
	if (mode == 6 && hitVolumeProxyShadowCaster(ro, rd, maxT)) {
		return true;
	}
	return false;
}

float dynamicShadowAlpha(RtHit hit, int mode) {
	if (!roomSurfaceMaterial(hit.materialId)) {
		return 0.0;
	}

	float shadow = 0.0;
	for (int i = 0; i < 6; i++) {
		vec3 lp = lightPosition(i);
		vec3 toL = lp - hit.p;
		float dist2 = max(dot(toL, toL), 1.0);
		float maxT = sqrt(dist2);
		vec3 ldir = toL / max(maxT, 0.0001);
		float ndotl = max(dot(hit.n, ldir), 0.0);
		if (ndotl <= 0.0) {
			continue;
		}
		if (hitDynamicShadowCaster(hit.p + hit.n * 2.0, ldir, maxT, mode)) {
			float strength = ndotl * lightIntensity(i) / (dist2 * 0.10);
			shadow += clamp(strength * 1.25, 0.0, 0.36);
		}
	}
	return clamp(shadow, 0.0, 0.68);
}

vec4 mirrorOverlay(RtHit mirrorHit, vec3 rd, vec2 uv, int mode) {
	vec3 reflected = normalize(reflect(rd, mirrorHit.n));
	vec3 reflectedOrigin = mirrorHit.p + reflected * 1.5;
	RtHit reflectedHit;
	vec3 reflectedColor;
	float alpha = 0.90;
	if (mode == 6) {
		bool hasHit = traceScene(reflectedOrigin, reflected, 0, reflectedHit);
		float tMax = hasHit ? reflectedHit.t : 1800.0;
		reflectedColor = hasHit ? shadeRay(reflectedOrigin, reflected, 0) : vec3(0.015, 0.020, 0.030);
		vec4 volume = shadeVolumeProxyRaw(reflectedOrigin, reflected, tMax);
		if (volume.a > 0.01) {
			reflectedColor = mix(reflectedColor, volume.rgb, volume.a);
		}
		alpha = hasHit && roomSurfaceMaterial(reflectedHit.materialId) ? 0.82 : 0.88;
	} else if (traceScene(reflectedOrigin, reflected, mode, reflectedHit)) {
		reflectedColor = shadeRay(reflectedOrigin, reflected, mode);
		alpha = roomSurfaceMaterial(reflectedHit.materialId) ? 0.82 : 0.90;
	} else {
		reflectedColor = vec3(0.015, 0.020, 0.030);
		alpha = 0.70;
	}
	vec3 color = tonemapRt(reflectedColor * 0.92 + vec3(0.006, 0.008, 0.008));
	vec3 glass = vec3(0.08, 0.12, 0.14) + pow(max(dot(-rd, mirrorHit.n), 0.0), 12.0) * vec3(0.14, 0.18, 0.20);
	color = mix(color, color + glass, 0.30);
	return vec4(color, alpha);
}

vec4 mirrorPanelOverlay(RtHit mirrorHit, vec3 rd, vec2 uv) {
	vec4 roomReflection = mirrorOverlay(mirrorHit, rd, uv, 0);
	vec2 rel = vec2(abs(mirrorHit.p.y) / 384.0, abs(mirrorHit.p.z - 240.0) / 192.0);
	float edge = max(rel.x, rel.y);
	float frame = smoothstep(0.925, 0.985, edge);
	float bevel = smoothstep(0.72, 0.94, edge) * (1.0 - frame);
	float facing = max(dot(-rd, mirrorHit.n), 0.0);
	float fresnel = pow(max(1.0 - facing, 0.0), 4.0);
	vec3 glass = roomReflection.rgb;
	vec3 tint = vec3(0.10, 0.15, 0.16) + vec3(0.05, 0.06, 0.06) * fresnel;
	vec3 frameColor = mix(vec3(0.025, 0.035, 0.035), vec3(0.12, 0.14, 0.13), smoothstep(0.965, 1.0, edge));

	glass = mix(glass, tint, 0.22) + bevel * vec3(0.030, 0.038, 0.038);
	return vec4(mix(glass, frameColor, frame), mix(0.92, 0.98, frame));
}

vec4 mirrorFrameOverlay(RtHit mirrorHit) {
	vec2 rel = vec2(abs(mirrorHit.p.y) / 384.0, abs(mirrorHit.p.z - 240.0) / 192.0);
	float edge = max(rel.x, rel.y);
	float frame = smoothstep(0.900, 0.975, edge);
	if (frame <= 0.001) {
		return vec4(0.0);
	}
	return vec4(mix(vec3(0.040, 0.055, 0.055), vec3(0.18, 0.20, 0.18), frame), frame * 0.98);
}

vec4 mirrorSurfaceMiddleOverlay(RtHit mirrorHit, vec3 rd, vec2 uv) {
	vec3 reflected = normalize(reflect(rd, mirrorHit.n));
	vec3 reflectedOrigin = mirrorHit.p + reflected * 1.5;
	RtHit roomHit;
	RtHit proxyHit;
	vec3 reflectedColor;
	float alpha = 0.90;
	bool hasRoom = traceScene(reflectedOrigin, reflected, 0, roomHit);

	if (hasRoom) {
		reflectedColor = shadeRay(reflectedOrigin, reflected, 0);
		alpha = roomSurfaceMaterial(roomHit.materialId) ? 0.82 : 0.90;
	} else {
		reflectedColor = vec3(0.015, 0.020, 0.030);
		alpha = 0.70;
	}

	proxyHit.t = hasRoom ? roomHit.t : 100000.0;
	proxyHit.p = vec3(0.0);
	proxyHit.n = vec3(0.0, 0.0, 1.0);
	proxyHit.baseColor = vec3(0.0);
	proxyHit.emission = vec3(0.0);
	proxyHit.reflective = 0.0;
	proxyHit.roomId = 2;
	proxyHit.materialId = 0;
	if (hitSurfaceProxyObject(reflectedOrigin, reflected, 1, proxyHit)) {
		reflectedColor = shadeDirect(proxyHit, reflected, 5);
		alpha = 0.90;
	}

	vec3 color = tonemapRt(reflectedColor * 0.92 + vec3(0.006, 0.008, 0.008));
	vec3 glass = vec3(0.08, 0.12, 0.14) + pow(max(dot(-rd, mirrorHit.n), 0.0), 12.0) * vec3(0.14, 0.18, 0.20);
	color = mix(color, color + glass, 0.30);
	return vec4(color, alpha);
}

float reflectionInputSignal(vec4 surface, vec4 volume) {
	float surfaceSignal = max(surface.r, max(surface.g, surface.b));
	float volumeSignal = max(volume.r, max(volume.g, volume.b));
	return max(surfaceSignal, volumeSignal);
}

bool neuralMirrorOnly() {
	return (neural.activeObjectMeta.w & 256) != 0;
}

vec4 renderMirrorOnlyMode(vec2 uv, int mode, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit mirrorHit;
	RtHit objectHit;
	vec3 reflected;
	vec3 reflectedOrigin;

	outRoomId = 2;
	mirrorHit.t = 100000.0;
	mirrorHit.p = vec3(0.0);
	mirrorHit.n = vec3(0.0, 0.0, 1.0);
	mirrorHit.baseColor = vec3(0.0);
	mirrorHit.emission = vec3(0.0);
	mirrorHit.reflective = 0.0;
	mirrorHit.roomId = 2;
	mirrorHit.materialId = 0;

	if (!hitMirror(ro, rd, mirrorHit)) {
		return vec4(0.0, 0.0, 0.0, 1.0);
	}

	reflected = normalize(reflect(rd, mirrorHit.n));
	reflectedOrigin = mirrorHit.p + reflected * 1.5;

	if (mode == 6) {
		vec4 volume = shadeVolumeProxyObjectRaw(reflectedOrigin, reflected, 1, 1800.0);
		return volume.a > 0.01 ? vec4(tonemapRt(volume.rgb), 1.0) : vec4(0.0, 0.0, 0.0, 1.0);
	}

	objectHit.t = 100000.0;
	objectHit.p = vec3(0.0);
	objectHit.n = vec3(0.0, 0.0, 1.0);
	objectHit.baseColor = vec3(0.0);
	objectHit.emission = vec3(0.0);
	objectHit.reflective = 0.0;
	objectHit.roomId = 2;
	objectHit.materialId = 0;

	if (mode == 5) {
		if (!hitSurfaceProxyObject(reflectedOrigin, reflected, 1, objectHit)) {
			return vec4(0.0, 0.0, 0.0, 1.0);
		}
		return vec4(tonemapRt(shadeDirect(objectHit, reflected, 5) * 0.74), 1.0);
	}

	if (!hitExactMiddleObject(reflectedOrigin, reflected, objectHit)) {
		return vec4(0.0, 0.0, 0.0, 1.0);
	}
	return vec4(tonemapRt(shadeDirect(objectHit, reflected, 4) * 0.88), 1.0);
}

vec4 renderLiveMode(vec2 uv, int mode, out int outRoomId) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit roomHit;

	if (neuralMirrorOnly() && mode >= 4 && mode <= 6) {
		return renderMirrorOnlyMode(uv, mode, outRoomId);
	}

	if (traceScene(ro, rd, mode == 6 ? 0 : mode, roomHit)) {
		outRoomId = roomHit.roomId;
	} else {
		outRoomId = roomIdForPoint(ro);
	}

	if (mode == 6) {
		vec4 volume = shadeVolumeOverlay(ro, rd);
		if (roomHit.materialId == 30) {
			vec4 mirror = mirrorOverlay(roomHit, rd, uv, mode);
			if (volume.a > 0.01) {
				return vec4(mix(mirror.rgb, volume.rgb, clamp(volume.a, 0.0, 1.0)), max(mirror.a, volume.a));
			}
			return mirror;
		}
		if (volume.a > 0.01) {
			return volume;
		}
		float shadow = dynamicShadowAlpha(roomHit, mode);
		return shadow > 0.01 ? vec4(0.0, 0.0, 0.0, shadow) : vec4(0.0);
	}

	if (roomHit.materialId == 30) {
		return mirrorOverlay(roomHit, rd, uv, mode);
	}

	if (!liveContributionMaterial(roomHit.materialId)) {
		float shadow = dynamicShadowAlpha(roomHit, mode);
		return shadow > 0.01 ? vec4(0.0, 0.0, 0.0, shadow) : vec4(0.0);
	}

	float alpha = roomHit.materialId >= 40 && roomHit.materialId <= 49 ? 0.84 : 0.96;
	float gain = roomHit.materialId >= 40 && roomHit.materialId <= 49 ? 0.74 : 0.88;
	return vec4(tonemapRt(shadeRay(ro, rd, mode) * gain), alpha);
}

bool activeObjectId(int objectId) {
	if (neural.activeObjectIds0.x == objectId || neural.activeObjectIds0.y == objectId ||
			neural.activeObjectIds0.z == objectId || neural.activeObjectIds0.w == objectId) {
		return true;
	}
	return neural.activeObjectIds1.x == objectId || neural.activeObjectIds1.y == objectId ||
		neural.activeObjectIds1.z == objectId || neural.activeObjectIds1.w == objectId;
}

bool activeObjectSlot(int objectIndex) {
	if (objectIndex < 0 || objectIndex >= neural.objectCount || objectIndex >= 3) {
		return false;
	}
	return activeObjectId(neural.objectId[objectIndex]);
}

vec3 activeMarkerCenter(int objectIndex) {
	vec3 c = objectCenter(objectIndex);
	c.z = objectIndex == 0 ? 356.0 : (objectIndex == 2 ? 374.0 : 370.0);
	return c;
}

bool hitActiveMarkerRay(vec3 ro, vec3 rd, out float bestT, out vec3 markerNormal, out int markerIndex) {
	bool found = false;
	bestT = 100000.0;
	markerNormal = vec3(0.0, 0.0, 1.0);
	markerIndex = -1;
	if (neural.activeObjectMeta.z == 0) {
		return false;
	}
	for (int objectIndex = 0; objectIndex < 3; objectIndex++) {
		float t;
		vec3 n;
		if (!activeObjectSlot(objectIndex)) {
			continue;
		}
		if (intersectSphere(ro, rd, activeMarkerCenter(objectIndex), 24.0, t, n) && t < bestT) {
			bestT = t;
			markerNormal = n;
			markerIndex = objectIndex;
			found = true;
		}
	}
	return found;
}

vec4 shadeActiveMarker(vec3 ro, vec3 rd, float t, vec3 n, int markerIndex, bool reflected) {
	vec3 p = ro + rd * t;
	vec3 ldir = normalize(vec3(-0.35, 0.25, 0.90));
	float shade = 0.36 + 0.48 * max(dot(n, ldir), 0.0) + 0.18 * max(n.z, 0.0);
	vec3 roomTint = roomColorById(objectRoomId(markerIndex));
	vec3 color = vec3(0.02, 0.90, 0.14) * shade + roomTint * 0.035;
	float rim = pow(max(0.0, 1.0 - max(dot(-rd, n), 0.0)), 3.0);
	color += vec3(0.08, 0.55, 0.14) * rim;
	color *= 0.92 + 0.08 * sin(neural.viewSeed.x * 6.0 + p.z * 0.035);
	if (reflected) {
		color *= vec3(0.70, 0.86, 0.76);
	}
	return vec4(clamp(color, 0.0, 1.0), reflected ? 0.78 : 0.92);
}

vec4 renderActiveMarkerOverlay(vec2 uv) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	float bestT;
	vec3 n;
	int markerIndex;

	if (hitActiveMarkerRay(ro, rd, bestT, n, markerIndex)) {
		return shadeActiveMarker(ro, rd, bestT, n, markerIndex, false);
	}

	RtHit mirrorHit;
	mirrorHit.t = 100000.0;
	if (hitMirror(ro, rd, mirrorHit)) {
		vec3 reflected = normalize(reflect(rd, mirrorHit.n));
		vec3 reflectedOrigin = mirrorHit.p + reflected * 1.5;
		if (hitActiveMarkerRay(reflectedOrigin, reflected, bestT, n, markerIndex)) {
			return shadeActiveMarker(reflectedOrigin, reflected, bestT, n, markerIndex, true);
		}
	}

	return vec4(0.0);
}

vec4 compositeOverlay(vec4 base, vec4 overlay) {
	float a = clamp(overlay.a, 0.0, 1.0);
	if (a <= 0.001) {
		return base;
	}
	return vec4(mix(base.rgb, overlay.rgb, a), max(base.a, a));
}

int objectIndexForId(int id) {
	int count = clamp(neural.objectCount, 0, MAX_NEURAL_OBJECTS);
	for (int i = 0; i < count; i++) {
		if (neural.objectId[i] == id) {
			return i;
		}
	}
	return -1;
}

int objectIndexForProxyMaterial(int materialId) {
	if (materialId >= 40 && materialId < 40 + MAX_NEURAL_OBJECTS) {
		int index = materialId - 40;
		if (index >= 0 && index < neural.objectCount) {
			return index;
		}
	}
	return -1;
}

bool objectReadyForCorrection(int objectIndex) {
	if (objectIndex < 0 || objectIndex >= neural.objectCount) {
		return false;
	}
	if (neural.objectHasWeights[objectIndex] == 0) {
		return false;
	}
	return activeObjectId(neural.objectId[objectIndex]);
}

bool neuralMlpEnabled() {
	return (neural.activeObjectMeta.w & 255) != 0;
}

int neuralMlpMode() {
	return neural.activeObjectMeta.w & 255;
}

bool proxyObjectVisibleForRay(vec3 ro, vec3 rd, out int objectIndex, out RtHit proxyHit) {
	objectIndex = -1;
	if (!traceScene(ro, rd, 5, proxyHit)) {
		return false;
	}

	objectIndex = objectIndexForProxyMaterial(proxyHit.materialId);
	if (objectReadyForCorrection(objectIndex)) {
		return true;
	}

	if (proxyHit.materialId == 30) {
		vec3 reflected = normalize(reflect(rd, proxyHit.n));
		vec3 reflectedOrigin = proxyHit.p + reflected * 1.5;
		RtHit reflectedHit;
		if (traceScene(reflectedOrigin, reflected, 5, reflectedHit)) {
			objectIndex = objectIndexForProxyMaterial(reflectedHit.materialId);
			if (!objectReadyForCorrection(objectIndex)) {
				return false;
			}
			proxyHit = reflectedHit;
			return true;
		}
	}

	return false;
}

bool renderObjectCorrection(vec2 uv, out vec4 correction, out vec4 exact, out int outRoomId, out int outObjectIndex) {
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ro = neural.cameraOrigin.xyz;
	vec3 rd = normalize(neural.cameraForward.xyz + neural.cameraRight.xyz * ndc.x + neural.cameraUp.xyz * ndc.y);
	RtHit proxyHit;
	vec3 surfaceFeature;
	vec3 volumeFeature;
	vec3 volumeEmission;
	vec2 features;
	vec3 corrected;
	float density;

	outRoomId = roomIdForPoint(ro);
	outObjectIndex = -1;
	correction = vec4(0.0);
	exact = vec4(0.0);

	if (!proxyObjectVisibleForRay(ro, rd, outObjectIndex, proxyHit)) {
		return false;
	}

	outRoomId = proxyHit.roomId;
	if (outObjectIndex < 0 || outObjectIndex >= 3) {
		return false;
	}

	surfaceFeature = tonemapRt(surfaceProxyColor(proxyHit.p, outObjectIndex) * 0.74);
	density = max(volumeObjectDensity(proxyHit.p, outObjectIndex), 0.08);
	volumeEmission = volumeObjectEmission(proxyHit.p, outObjectIndex, density);
	volumeFeature = tonemapRt(volumeEmission * 1.25);
	features = vec2(luminanceRgb(surfaceFeature), luminanceRgb(volumeFeature));
	if (neuralMlpEnabled()) {
		corrected = evalObjectNetworkInput(outObjectIndex, clamp(features, 0.0, 1.0));
	} else {
		corrected = mix(surfaceFeature, volumeFeature, 0.35);
	}
	exact = vec4(tonemapRt(shadeRay(ro, rd, 4) * 0.88), 0.96);
	correction = vec4(corrected, 0.96);

	return true;
}

float sigmoidReflection(float x) {
	return 1.0 / (1.0 + exp(-clamp(x, -60.0, 60.0)));
}

vec3 safeReflectionRgb(vec4 v) {
	vec3 rgb = clamp(v.rgb, 0.0, 1.0);
	if (any(isnan(rgb)) || any(isinf(rgb))) {
		return vec3(0.0);
	}
	return rgb;
}

bool reflectionMlpLoaded() {
	return neural.reflectionMeta.x != 0 &&
		neural.reflectionMeta.y == NEURAL_REFLECTION_DECAL_GEOM_INPUTS &&
		neural.reflectionMeta.z == NEURAL_REFLECTION_DECAL_TAG;
}

bool reflectionDecalLoaded() {
	return neural.reflectionMeta.x != 0 &&
		neural.reflectionMeta.y == NEURAL_REFLECTION_DECAL_GEOM_INPUTS &&
		neural.reflectionMeta.z == NEURAL_REFLECTION_DECAL_TAG;
}

float reflectionRel(float v, float c, float e) {
	return clamp((v - c) / max(e, 0.0001), -8.0, 8.0);
}

bool reflectionInsideSelectedBounds(vec2 uv) {
	vec4 b = vec4(neural.reflectionBbox[0], neural.reflectionBbox[1], neural.reflectionBbox[2], neural.reflectionBbox[3]);
	vec2 margin = vec2(0.015, 0.020);
	return reflectionDecalLoaded() &&
		uv.x >= b.x - margin.x && uv.x <= b.z + margin.x &&
		uv.y >= b.y - margin.y && uv.y <= b.w + margin.y;
}

