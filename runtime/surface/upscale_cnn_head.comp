#version 450
// Shared4x stage 3: four phase-major head rows plus the canonical bilinear base.
// SOURCE PREPARED: compilation, device parity and timing remain root-owned.
layout(constant_id=0) const uint cnnWidth=8u;
layout(push_constant) uniform PixelExtent { uvec4 extent; } frame;
layout(std430,binding=2) readonly buffer CnnAsset { uint data[]; } cnnAsset;
layout(binding=11) uniform sampler2D lrLinearTexture;
layout(rgba32f,binding=5) uniform writeonly image2D outputImage;
// Stage inputs are also length-checked here before consuming the feature map.
layout(std430,binding=15) readonly buffer CnnDisplay { vec4 data[]; } cnnDisplay;
layout(std430,binding=16) readonly buffer CnnConv0 { vec4 data[]; } cnnConv0;
layout(std430,binding=17) readonly buffer CnnConv1 { vec4 data[]; } cnnConv1;
layout(local_size_x=8,local_size_y=8) in;

// Literal prior mode9/original bilinear helper. Keep gamma unchanged.
vec4 upDisplay(vec4 linearAssociated) {
    float alpha=clamp(linearAssociated.a,0.0,1.0);
    vec3 straight=max(linearAssociated.rgb,vec3(0.0))/max(alpha,1e-8);
    return vec4(alpha*pow(straight/(vec3(1.0)+straight),vec3(1.0/2.2)),alpha);
}
uint cnnParameterCount() { return 9u*cnnWidth*cnnWidth+102u*cnnWidth+64u; }
bool cnnHeaderValid() {
    if(cnnAsset.data.length()<64) return false;
    if(cnnWidth!=8u&&cnnWidth!=16u&&cnnWidth!=32u) return false;
    uint parameters=cnnParameterCount();
    // Whole-file/payload SHA256, source/protocol/baseline bindings and finite
    // FP32 payload values are mandatory host checks before this SSBO upload.
    if(cnnAsset.data[0]!=0x34524c4eu||cnnAsset.data[1]!=0x31303030u
        ||cnnAsset.data[2]!=256u||cnnAsset.data[3]!=1u||cnnAsset.data[4]!=1u
        ||cnnAsset.data[5]!=cnnWidth||cnnAsset.data[6]!=4u||cnnAsset.data[7]!=64u
        ||cnnAsset.data[8]!=3u||cnnAsset.data[9]!=4u||cnnAsset.data[10]!=parameters
        ||cnnAsset.data[11]!=1u||cnnAsset.data[12]!=1u||cnnAsset.data[13]!=1u
        ||cnnAsset.data[14]!=1u||cnnAsset.data[15]!=1u
        ||cnnAsset.data[48]!=4u*parameters||cnnAsset.data[49]!=0u
        ||cnnAsset.data[50]!=0x3f800000u||cnnAsset.data[51]!=0x3f800000u
        ||uint(cnnAsset.data.length())!=64u+parameters) return false;
    for(uint word=52u;word<64u;word++) if(cnnAsset.data[word]!=0u) return false;
    return true;
}
float cnnWeight(uint word) { return uintBitsToFloat(cnnAsset.data[word]); }

void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 hrSize=ivec2(frame.extent.xy),lrSize=ivec2(frame.extent.zw);
    if(any(greaterThanEqual(pixel,imageSize(outputImage)))) return;
    if(any(greaterThanEqual(pixel,hrSize))) return;
    if(!all(equal(hrSize,ivec2(1920,1080)))
        ||!all(equal(lrSize,ivec2(480,270)))
        ||!all(equal(imageSize(outputImage),hrSize))
        ||!all(equal(textureSize(lrLinearTexture,0),lrSize))||!cnnHeaderValid()
        ||uint(cnnDisplay.data.length())!=129600u
        ||uint(cnnConv0.data.length())!=129600u*(cnnWidth/4u)
        ||uint(cnnConv1.data.length())!=129600u*(cnnWidth/4u)) {
        imageStore(outputImage,pixel,vec4(1.0,0.0,1.0,1.0));
        return;
    }
    // Literal original upscale_pixel_bilinear.comp interpolation and transfer.
    vec2 low=(vec2(pixel)+vec2(0.5))*(vec2(lrSize)/vec2(hrSize))-vec2(0.5);
    ivec2 cell=ivec2(floor(low));
    vec2 phase=low-floor(low);
    vec4 linear=vec4(0.0);
    // Old mode6 TL/TR/BL/BR fetch and accumulation order, without diagnostics.
    for(int p=0;p<4;p++) {
        ivec2 offset=ivec2(p%2,p/2);
        ivec2 lowPixel=clamp(cell+offset,ivec2(0),lrSize-ivec2(1));
        float spatial=(offset.x==0?1.0-phase.x:phase.x)
                     *(offset.y==0?1.0-phase.y:phase.y);
        linear+=texelFetch(lrLinearTexture,lowPixel,0)*spatial;
    }
    linear.rgb=max(linear.rgb,vec3(0.0));
    linear.a=clamp(linear.a,0.0,1.0);
    if(linear.a<=1e-8) linear.rgb=vec3(0.0);
    vec4 base=upDisplay(linear);

    uint groups=cnnWidth/4u;
    ivec2 lrCell=pixel/4;
    uint featureBase=uint(lrCell.y*lrSize.x+lrCell.x)*groups;
    uint phaseIndex=uint(4*(pixel.y%4)+pixel.x%4);
    uint firstRow=4u*phaseIndex;
    uint weights=64u+38u*cnnWidth+9u*cnnWidth*cnnWidth;
    uint bias=weights+64u*cnnWidth;
    vec4 raw=vec4(cnnWeight(bias+firstRow),cnnWeight(bias+firstRow+1u),
                  cnnWeight(bias+firstRow+2u),cnnWeight(bias+firstRow+3u));
    for(uint group=0u;group<groups;group++) {
        vec4 value=cnnConv1.data[featureBase+group];
        for(uint component=0u;component<4u;component++) {
            uint channel=4u*group+component;
            // Row-major head[64,C]; RGBA is contiguous within each phase.
            uint weight=weights+firstRow*cnnWidth+channel;
            vec4 coefficient=vec4(cnnWeight(weight),cnnWeight(weight+cnnWidth),
                                  cnnWeight(weight+2u*cnnWidth),cnnWeight(weight+3u*cnnWidth));
            raw+=value[component]*coefficient;
        }
    }
    // shared4x.project; do not skip alpha-zero bases: new coverage is learnable.
    vec4 delta=tanh(raw);
    float alpha=clamp(base.a+delta.a,0.0,1.0);
    vec3 rgb=min(max(base.rgb+delta.rgb,vec3(0.0)),vec3(alpha));
    imageStore(outputImage,pixel,vec4(rgb,alpha));
}
