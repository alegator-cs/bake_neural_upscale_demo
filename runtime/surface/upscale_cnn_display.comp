#version 450
// Shared4x stage 0: transfer each native LR pixel once. Pixel-only input.
// SOURCE PREPARED: compilation, device parity and timing remain root-owned.
layout(push_constant) uniform PixelExtent { uvec4 extent; } frame;
layout(binding=11) uniform sampler2D lrLinearTexture;
layout(std430,binding=15) writeonly buffer CnnDisplay { vec4 data[]; } cnnDisplay;
layout(local_size_x=8,local_size_y=8) in;

// Literal prior mode9 helper. Keep the GLSL gamma expression unchanged.
vec4 upDisplay(vec4 linearAssociated) {
    float alpha=clamp(linearAssociated.a,0.0,1.0);
    vec3 straight=max(linearAssociated.rgb,vec3(0.0))/max(alpha,1e-8);
    return vec4(alpha*pow(straight/(vec3(1.0)+straight),vec3(1.0/2.2)),alpha);
}

void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 hrSize=ivec2(frame.extent.xy),lrSize=ivec2(frame.extent.zw);
    if(any(greaterThanEqual(pixel,lrSize))) return;
    if(!all(equal(hrSize,ivec2(1920,1080)))
        ||!all(equal(lrSize,ivec2(480,270)))
        ||!all(equal(textureSize(lrLinearTexture,0),lrSize))
        ||uint(cnnDisplay.data.length())!=129600u) return;
    // Unlike the canonical interpolated base, direct LR inputs have no
    // separate near-zero-alpha RGB clearing. This is exactly old mode9.
    cnnDisplay.data[uint(pixel.y*lrSize.x+pixel.x)]=
        upDisplay(texelFetch(lrLinearTexture,pixel,0));
}
