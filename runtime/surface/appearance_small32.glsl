
// Canonical NLSF0001 helper contract; generated by surface_model.py.
// Define SF_CHART(i), SF_ATLAS(i), SF_WEIGHT(i) before this helper text.
float sfSoftplus(float x) {
    float z=exp(-abs(x));
    float tail=(z<0.0001) ? z*(1.0-0.5*z) : log(1.0+z);
    return max(x,0.0)+tail;
}
vec3 sfSoftplus3(vec3 v) { return vec3(sfSoftplus(v.x),sfSoftplus(v.y),sfSoftplus(v.z)); }
int sfChartCoordinate(int x,int size,bool periodic) {
    if(!periodic) return clamp(x,0,size-1);
    if(x>=0) return x%size;
    return size-1-((-1-x)%size);
}
vec4 sfDerivativeFeatures(vec4 derivatives,uvec4 chart) {
    return clamp(derivatives*vec4(chart.y,chart.z,chart.y,chart.z),vec4(-8.0),vec4(8.0))/8.0;
}
void sfOrientNormals(inout vec3 N,inout vec3 Ng,vec3 V,out vec3 reflection,out float ndotv) {
    N=normalize(N); Ng=normalize(Ng); V=normalize(V);
    if(dot(Ng,V)<0.0) {N=-N;Ng=-Ng;}
    reflection=normalize(reflect(-V,N)); ndotv=clamp(dot(N,V),0.0,1.0);
}
vec4 sfResolve(vec3 rgb[4],bool hit[4],bool incident) {
    vec3 associated=vec3(0.0); float alpha=0.0;
    for(int i=0;i<4;i++) if(hit[i]) {associated+=rgb[i]*0.25;alpha+=0.25;}
    if(!incident || alpha==0.0) return vec4(0.0);
    vec3 straight=max(associated,vec3(0.0))/alpha;
    return vec4(alpha*pow(straight/(vec3(1.0)+straight),vec3(1.0/2.2)),alpha);
}

void sfAtlas(int chartID,vec2 uv,out float values[12]) {
    uvec4 m=SF_CHART(chartID); vec2 xy=uv*vec2(m.y,m.z)-vec2(0.5);
    ivec2 ij=ivec2(floor(xy)); vec2 f=xy-vec2(ij);
    for(int c=0;c<12;c++) values[c]=0.0;
    for(int dy=0;dy<2;dy++) for(int dx=0;dx<2;dx++) {
        int x=sfChartCoordinate(ij.x+dx,int(m.y),(m.w&1u)!=0u);
        int y=sfChartCoordinate(ij.y+dy,int(m.z),(m.w&2u)!=0u);
        float w=(dx==1?f.x:1.0-f.x)*(dy==1?f.y:1.0-f.y);
        int address=(int(m.x)+y*int(m.y)+x)*12;
        for(int c=0;c<12;c++) values[c]+=w*SF_ATLAS(address+c);
    }
}


#define RF_CHANNELS 4

layout(std430,binding=7) readonly buffer Correction {uint data[];} correction;
uvec4 rfChart(int c) {uint i=64u+uint(c)*4u;return uvec4(correction.data[i],correction.data[i+1u],correction.data[i+2u],correction.data[i+3u]);}
float rfAtlasValue(int i) {return uintBitsToFloat(correction.data[64u+correction.data[9]*4u+uint(i)]);}
float rfWeight(int i) {return uintBitsToFloat(correction.data[64u+correction.data[9]*4u+correction.data[4]*correction.data[5]+uint(i)]);}
void rfAtlas(int chartID,vec2 uv,out float values[RF_CHANNELS]) {
    uvec4 m=rfChart(chartID);vec2 xy=uv*vec2(m.y,m.z)-vec2(.5);ivec2 ij=ivec2(floor(xy));vec2 f=xy-vec2(ij);
    for(int c=0;c<RF_CHANNELS;c++)values[c]=0.0;
    for(int dy=0;dy<2;dy++)for(int dx=0;dx<2;dx++) {
        int x=sfChartCoordinate(ij.x+dx,int(m.y),(m.w&1u)!=0u),y=sfChartCoordinate(ij.y+dy,int(m.z),(m.w&2u)!=0u);
        float w=(dx==1?f.x:1.0-f.x)*(dy==1?f.y:1.0-f.y);
        int offset=(int(m.x)+y*int(m.y)+x)*RF_CHANNELS;
        for(int c=0;c<RF_CHANNELS;c++)values[c]+=w*rfAtlasValue(offset+c);
    }
}


// NLSR0001: [latent4, display-compressed baseline RGB3, reflection3, roughness,
// NdotV, derivative4, reflection sin/cos XYZ for bands 1,2,4]. Two ReLU layers.
vec3 sfShade(int chartID,vec2 uv,vec3 position,vec3 N,vec3 reflection,
             float roughness,float metallic,float ndotv,vec4 rawDerivatives,bool hit) {
    if(!hit)return vec3(0);
    float base[12];sfAtlas(chartID,uv,base);vec3 logits;
    for(int c=0;c<3;c++)logits[c]=base[c*4]+base[c*4+1]*reflection.x+base[c*4+2]*reflection.y+base[c*4+3]*reflection.z;
    float values[RF_CHANNELS];rfAtlas(chartID,uv,values);
    float features[34];vec3 color=sfSoftplus3(logits);color=color/(vec3(1)+color);
    for(int i=0;i<4;i++)features[i]=values[i];
    for(int i=0;i<3;i++){features[4+i]=color[i];features[7+i]=reflection[i];}
    features[10]=roughness;features[11]=clamp(ndotv,0.0,1.0);
    vec4 d=sfDerivativeFeatures(rawDerivatives,rfChart(chartID));for(int i=0;i<4;i++)features[12+i]=d[i];
    const float pi=3.14159265358979323846;
    for(int band=0;band<3;band++) {
        vec3 phase=reflection*(pi*(band==0?1.0:(band==1?2.0:4.0)));vec3 sine=sin(phase),cosine=cos(phase);
        for(int i=0;i<3;i++){features[16+band*6+i]=sine[i];features[19+band*6+i]=cosine[i];}
    }
    float a[32],b[32];
    for(int i=0;i<32;i++){float sum=rfWeight(1088+i);for(int j=0;j<34;j++)sum+=rfWeight(i*34+j)*features[j];a[i]=max(sum,0.0);}
    for(int i=0;i<32;i++){float sum=rfWeight(2144+i);for(int j=0;j<32;j++)sum+=rfWeight(1120+i*32+j)*a[j];b[i]=max(sum,0.0);}
    vec3 delta;for(int i=0;i<3;i++){float sum=rfWeight(2272+i);for(int j=0;j<32;j++)sum+=rfWeight(2176+i*32+j)*b[j];delta[i]=sum;}
    return sfSoftplus3(logits+delta);
}
